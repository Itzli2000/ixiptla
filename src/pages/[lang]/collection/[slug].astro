---
import { getCollection, getEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { getLocalizedUrl, getAlternateUrls } from "../../../i18n/routes";
import { getCollectionName } from "../../../i18n/collections";
import Layout from "../../../layouts/Layout.astro";
import type { Language } from "../../../types";
import ArtifactHero from "../../../components/artifact/ArtifactHero.astro";
import ArtifactMetadata from "../../../components/artifact/ArtifactMetadata.astro";
import CulturalContext from "../../../components/artifact/CulturalContext.astro";
import RelatedArtifacts from "../../../components/artifact/RelatedArtifacts.astro";
import BreadcrumbNavigation from "../../../components/ui/BreadcrumbNavigation.astro";
import ArtifactNavigation from "../../../components/artifact/ArtifactNavigation.astro";
import BackToTopButton from "../../../components/ui/BackToTopButton.astro";
import type { BreadcrumbItem } from "../../../types/artifact";

export async function getStaticPaths() {
  const languages: Language[] = ["en", "es"];
  const paths: Array<{ params: { lang: Language; slug: string } }> = [];

  for (const lang of languages) {
    const collectionName = lang === "es" ? "artefactos" : "artifacts";
    const artifacts = await getCollection(collectionName);
    for (const artifact of artifacts) {
      paths.push({
        params: { lang, slug: artifact.data.slug },
      });
    }
  }

  return paths;
}

const { lang: langParam, slug } = Astro.params;
const lang = langParam as Language;
const t = useTranslations(lang);
const collectionName = getCollectionName(lang);

const artifacts = await getCollection(collectionName);
const { data: artifact } = await getEntry(collectionName, slug);

const sameCultureArtifacts = artifacts
  .filter(
    (a) => a.data.culture === artifact.culture && a.data.slug !== artifact.slug,
  )
  .slice(0, 3);

const differentCultureArtifacts = artifacts
  .filter((a) => a.data.culture !== artifact.culture)
  .slice(0, 3);

const allRelatedArtifacts = [
  ...sameCultureArtifacts,
  ...differentCultureArtifacts,
];

const currentIndex = artifacts.findIndex((a) => a.data.slug === artifact.slug);
const prevArtifact = currentIndex > 0 ? artifacts[currentIndex - 1] : null;
const nextArtifact =
  currentIndex < artifacts.length - 1 ? artifacts[currentIndex + 1] : null;

const title = t("seo.artifact.titleTemplate")
  .replace("{title}", artifact.title)
  .replace("{culture}", artifact.culture);

const description = t("seo.artifact.descriptionTemplate")
  .replace("{title}", artifact.title)
  .replace("{culture}", artifact.culture)
  .replace("{period}", artifact.period)
  .replace("{description}", artifact.description.slice(0, 120) + "...");

const alternateUrlPaths = getAlternateUrls("collection", artifact.slug);
let canonicalURL: URL | undefined;
let imageURL: string = `/images/${artifact.image}`;
let alternateURLs: { en: URL; es: URL } | undefined;

if (Astro.site) {
  canonicalURL = new URL(
    getLocalizedUrl("collection", lang, artifact.slug),
    Astro.site,
  );
  imageURL = new URL(`/images/${artifact.image}`, Astro.site).toString();
  alternateURLs = {
    en: new URL(alternateUrlPaths.en, Astro.site),
    es: new URL(alternateUrlPaths.es, Astro.site),
  };
}

const breadcrumbItems: BreadcrumbItem[] = [
  {
    label: t("artifact.home"),
    href: `${getLocalizedUrl("home", lang)}#collection`,
  },
  {
    label: t("artifact.collection"),
    href: getLocalizedUrl("collection", lang),
  },
  { label: artifact.title, current: true, ariaCurrent: "page" },
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  image={imageURL}
  canonicalURL={canonicalURL}
  alternateURLs={alternateURLs}
  currentArtifact={artifact}
>
  <main class="min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary text-primary-content px-4 py-2 rounded-lg z-50"
    >
      {t("artifact.accessibility.skipToContent")}
    </a>

    <section class="pt-20 sm:pt-24 px-4 sm:px-6 lg:px-8 section-elevated">
      <div class="max-w-7xl mx-auto">
        <BreadcrumbNavigation items={breadcrumbItems} lang={lang} t={t} />
      </div>
    </section>

    <section
      id="main-content"
      class="px-4 sm:px-6 lg:px-8"
      aria-labelledby="artifact-title"
    >
      <div class="max-w-7xl mx-auto">
        <ArtifactHero artifact={artifact} lang={lang} t={t} />
      </div>
    </section>

    <section
      class="px-4 sm:px-6 lg:px-8 py-16 lg:py-24 section-sunken"
      aria-labelledby="metadata-title"
    >
      <div class="max-w-7xl mx-auto">
        <ArtifactMetadata artifact={artifact} lang={lang} t={t} />
      </div>
    </section>

    <section
      class="px-4 sm:px-6 lg:px-8 py-16 lg:py-24 section-elevated"
      aria-labelledby="cultural-context-title"
    >
      <CulturalContext artifact={artifact} lang={lang} t={t} />
    </section>

    <section
      class="px-4 sm:px-6 lg:px-8"
      aria-labelledby="related-artifacts-title"
    >
      <RelatedArtifacts
        relatedArtifacts={allRelatedArtifacts}
        currentCulture={artifact.culture}
        lang={lang}
        t={t}
      />
    </section>

    <ArtifactNavigation
      prevArtifact={prevArtifact}
      nextArtifact={nextArtifact}
      lang={lang}
      t={t}
    />

    <BackToTopButton lang={lang} t={t} />
  </main>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid rgb(var(--primary));
    outline-offset: 2px;
  }
</style>
