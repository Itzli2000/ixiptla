---
import Layout from "../../layouts/Layout.astro";
import ContactHeader from "../../components/contact/ContactHeader.astro";
import ContactCard from "../../components/contact/ContactCard.astro";
import ContactReasonCard from "../../components/contact/ContactReasonCard.astro";
import { Icon } from "astro-icon/components";
import { getContactData } from "../../data/contact";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import es from "../../i18n/languages/es.json";
import en from "../../i18n/languages/en.json";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const { hero, contactInfo } = getContactData(lang);

const formLabels = {
  name: t('contact.form.correspondentName'),
  namePlaceholder: t('contact.form.namePlaceholder'),
  email: t('contact.form.digitalAddress'),
  emailPlaceholder: t('contact.form.emailPlaceholder'),
  subject: t('contact.form.inquiryClassification'),
  message: t('contact.form.transmissionContent'),
  messagePlaceholder: t('contact.form.messagePlaceholder'),
  submit: t('contact.form.submit'),
  disclaimer: t('contact.form.disclaimer'),
  missionTitle: t('contact.sidebar.missionTitle'),
  missionText: t('contact.sidebar.missionText'),
  missionLink: t('contact.sidebar.readProtocol'),
  nodeTitle: t('contact.sidebar.physicalNode'),
  presenceTitle: t('contact.sidebar.digitalPresence'),
  protocol: t('contact.sidebar.protocol'),
  response: t('contact.sidebar.response'),
  encryption: t('contact.sidebar.encryption'),
  availability: t('contact.sidebar.availability'),
};

const subjectOptions = translations.contact.form.subjects;
---

<Layout title={hero.title} description={hero.description} lang={lang}>
  <main class="pb-24 px-4 sm:px-8 md:px-16 mx-auto min-h-screen">
    <ContactHeader
      title={hero.title}
      subtitle={hero.subtitle}
      description={hero.description}
      lang={lang}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <!-- Sidebar: Mission & Details -->
      <aside class="lg:col-span-4 space-y-16 order-2 lg:order-1">
        <!-- Mission Section -->
        <section>
          <h3 class="font-label text-(--oc-primary) uppercase text-xs tracking-widest mb-6 border-l-2 border-(--oc-primary) pl-4">
            {formLabels.missionTitle}
          </h3>
          <p class="font-body text-(--oc-on-surface-variant) text-sm leading-relaxed mb-6">
            {formLabels.missionText}
          </p>
          <a class="font-label text-(--oc-tertiary) uppercase text-[10px] tracking-widest hover:underline decoration-1 transition-all" href={`/${lang}/collection`}>
            {formLabels.missionLink} &rarr;
          </a>
        </section>

        <!-- Contact Methods -->
        <section>
          {contactInfo.methods.map((method, index) => (
            <ContactCard method={method} index={index} />
          ))}
        </section>

        <!-- Reasons / Why Contact -->
        <section>
          <h3 class="font-label text-(--oc-primary) uppercase text-xs tracking-widest mb-6 border-l-2 border-(--oc-primary) pl-4">
            {t("contact.reasons.title")}
          </h3>
          {contactInfo.reasons.map((reason, index) => (
            <ContactReasonCard reason={reason} index={index} />
          ))}
        </section>
      </aside>

      <!-- Main Form Section -->
      <div class="lg:col-span-8 order-1 lg:order-2">
        <div class="bg-(--oc-surface-container-low) p-6 sm:p-10 md:p-16 relative overflow-hidden">
          <form action="#" class="relative z-10 space-y-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
              <div class="space-y-4">
                <label class="font-label text-[10px] uppercase tracking-[0.3em] text-(--oc-tertiary) block mb-4">
                  {formLabels.name}
                </label>
                <input
                  type="text"
                  class="w-full bg-(--oc-surface-container-lowest) border-none text-(--oc-on-surface) font-body p-4 placeholder:text-(--oc-outline)/30 placeholder:uppercase placeholder:text-[10px] placeholder:tracking-widest focus:border-b-2 focus:border-(--oc-tertiary) focus:ring-0 transition-all"
                  placeholder={formLabels.namePlaceholder}
                />
              </div>
              <div class="space-y-4">
                <label class="font-label text-[10px] uppercase tracking-[0.3em] text-(--oc-tertiary) block mb-4">
                  {formLabels.email}
                </label>
                <input
                  type="email"
                  class="w-full bg-(--oc-surface-container-lowest) border-none text-(--oc-on-surface) font-body p-4 placeholder:text-(--oc-outline)/30 placeholder:uppercase placeholder:text-[10px] placeholder:tracking-widest focus:border-b-2 focus:border-(--oc-tertiary) focus:ring-0 transition-all"
                  placeholder={formLabels.emailPlaceholder}
                />
              </div>
            </div>

            <div class="space-y-4">
              <label class="font-label text-[10px] uppercase tracking-[0.3em] text-(--oc-tertiary) block mb-4">
                {formLabels.subject}
              </label>
              <select class="w-full bg-(--oc-surface-container-lowest) border-none text-(--oc-on-surface) font-label uppercase text-[10px] tracking-widest p-4 focus:border-b-2 focus:border-(--oc-tertiary) focus:ring-0 transition-all">
                {subjectOptions.map((option) => (
                  <option>{option}</option>
                ))}
              </select>
            </div>

            <div class="space-y-4">
              <label class="font-label text-[10px] uppercase tracking-[0.3em] text-(--oc-tertiary) block mb-4">
                {formLabels.message}
              </label>
              <textarea
                rows="6"
                class="w-full bg-(--oc-surface-container-lowest) border-none text-(--oc-on-surface) font-body p-4 placeholder:text-(--oc-outline)/30 placeholder:uppercase placeholder:text-[10px] placeholder:tracking-widest focus:border-b-2 focus:border-(--oc-tertiary) focus:ring-0 transition-all resize-none"
                placeholder={formLabels.messagePlaceholder}
              ></textarea>
            </div>

            <div class="pt-6">
              <button
                type="submit"
                class="w-full md:w-auto obsidian-gradient text-(--oc-on-primary) px-16 py-5 font-label uppercase text-xs tracking-[0.4em] font-bold hover:opacity-90 active:scale-95 transition-all shadow-xl"
              >
                {formLabels.submit}
              </button>
              <p class="mt-4 font-label text-[9px] text-(--oc-outline)/50 uppercase tracking-widest text-center md:text-left">
                {formLabels.disclaimer}
              </p>
            </div>
          </form>
        </div>

        <!-- Spec-Block Data Points -->
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-(--oc-surface-container-lowest) p-6">
            <span class="block font-label text-[9px] text-(--oc-primary)/60 uppercase mb-2">{formLabels.protocol}</span>
            <span class="block font-label text-xs text-(--oc-on-surface-variant)">TLS 1.3 ARC</span>
          </div>
          <div class="bg-(--oc-surface-container-lowest) p-6">
            <span class="block font-label text-[9px] text-(--oc-primary)/60 uppercase mb-2">{formLabels.response}</span>
            <span class="block font-label text-xs text-(--oc-on-surface-variant)">48-72 {t('contact.sidebar.hours')}</span>
          </div>
          <div class="bg-(--oc-surface-container-lowest) p-6">
            <span class="block font-label text-[9px] text-(--oc-primary)/60 uppercase mb-2">{formLabels.encryption}</span>
            <span class="block font-label text-xs text-(--oc-on-surface-variant)">256-BIT OBSIDIAN</span>
          </div>
          <div class="bg-(--oc-surface-container-lowest) p-6">
            <span class="block font-label text-[9px] text-(--oc-primary)/60 uppercase mb-2">{formLabels.availability}</span>
            <span class="block font-label text-xs text-(--oc-on-surface-variant)">GLOBAL / REMOTE</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
