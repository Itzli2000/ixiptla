---
import Layout from "../../layouts/Layout.astro";
import ContactHeader from "../../components/contact/ContactHeader.astro";
import ContactCard from "../../components/contact/ContactCard.astro";
import ContactReasonCard from "../../components/contact/ContactReasonCard.astro";
import { Icon } from "astro-icon/components";
import { getContactData } from "../../data/contact";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const { hero, contactInfo } = getContactData(lang);
---

<Layout title={hero.title} description={hero.description} lang={lang}>
  <main class="min-h-screen">
    <ContactHeader
      title={hero.title}
      subtitle={hero.subtitle}
      description={hero.description}
      lang={lang}
    />

    <!-- Contact Methods -->
    <section class="section-elevated py-16 lg:py-20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12" data-reveal>
          <h2 class="contact-section-title font-serif text-base-content mb-4">
            {t("contact.methods.title")}
          </h2>
          <p class="text-base-content/60 max-w-xl mx-auto">
            {t("contact.methods.description")}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5" data-reveal-stagger>
          {contactInfo.methods.map((method, index) => (
            <div data-reveal style={`--reveal-index: ${index}`}>
              <ContactCard method={method} index={index} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Reasons / Collaboration -->
    <section class="section-sunken py-16 lg:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14" data-reveal>
          <h2 class="contact-section-title font-serif text-base-content mb-4">
            {t("contact.reasons.title")}
          </h2>
          <p class="text-base-content/60 max-w-2xl mx-auto">
            {t("contact.reasons.description")}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" data-reveal-stagger>
          {contactInfo.reasons.map((reason, index) => (
            <div data-reveal style={`--reveal-index: ${index}`}>
              <ContactReasonCard reason={reason} index={index} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- About / CTA Section - Dark -->
    <section class="section-dark py-16 lg:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center" data-reveal>
          <div class="about-card rounded-2xl p-10 lg:p-14">
            <div class="flex justify-center mb-6">
              <div class="w-14 h-14 rounded-full bg-primary/15 flex items-center justify-center">
                <Icon name="mdi:temple-hindu" class="w-7 h-7 text-primary" />
              </div>
            </div>
            <h3 class="text-2xl lg:text-3xl font-serif mb-5 about-title">
              {t("contact.about.title")}
            </h3>
            <p class="about-description leading-relaxed mb-8 max-w-2xl mx-auto">
              {t("contact.about.description")}
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              {["Maya", "Mexica", "Acolhua", "Mixteca", "Teotihuacan"].map((culture) => (
                <a
                  href={`/${lang}/collection?culture=${culture.toLowerCase()}`}
                  class="culture-tag"
                >
                  {culture}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .about-card {
    background: oklch(100% 0 0 / 0.04);
    backdrop-filter: blur(16px);
    border: 1px solid oklch(100% 0 0 / 0.08);
  }

  .about-title {
    color: oklch(92% 0.005 83.24);
  }

  .about-description {
    color: oklch(70% 0.01 83.24);
  }

  .culture-tag {
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: oklch(80% 0.02 83.24);
    background: oklch(100% 0 0 / 0.06);
    border: 1px solid oklch(100% 0 0 / 0.1);
    transition: all 0.3s ease;
  }

  .culture-tag:hover {
    background: oklch(100% 0 0 / 0.12);
    color: oklch(92% 0.01 83.24);
    border-color: oklch(100% 0 0 / 0.2);
  }
</style>
