---
import { Scene3D } from "../../../components/three/Scene3D/Scene3D";
import ExperienceLayout from "../../../layouts/ExperienceLayout.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import {
  AVAILABLE_MODELS,
  getModelPath,
  getModelInfo,
} from "../../../data/models";
import type { Language } from "../../../types";
import { Icon } from "astro-icon/components";

export function getStaticPaths() {
  const languages: Language[] = ["en", "es"];
  const paths = [];

  for (const lang of languages) {
    for (const model of AVAILABLE_MODELS) {
      paths.push({ params: { lang, model } });
    }
  }

  return paths;
}

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const { model } = Astro.params;
const modelPath = model ? getModelPath(model) : null;
const info = model ? getModelInfo(model, lang) : null;
---

<ExperienceLayout
  title={info?.title[lang] ?? t("experience.modelNotFound.title")}
  description={info?.description[lang] ?? t("experience.modelNotFound.message")}
  lang={lang}
>
  <div
    class="experience-container relative w-full min-h-screen h-full text-base-content"
  >
    <button
      onclick="history.back()"
      class="experience-btn absolute top-4 left-4 z-50 gap-2"
    >
      <Icon name="mdi:arrow-left" class="w-4 h-4" />
      {t("artifact.back")}
    </button>

    <div class="absolute top-4 right-4 z-50 flex flex-col sm:flex-row gap-2">
      <button
        id="resetView"
        class="experience-btn"
      >
        {t("artifact.resetView")}
      </button>
      <button
        id="toggleAutoRotate"
        class="experience-btn"
        data-label-active={t("experience.autoRotate.stop")}
        data-label-inactive={t("experience.autoRotate.start")}
      >
        {t("artifact.autoRotate")}
      </button>
    </div>

    <div class="w-full h-full">
      {
        modelPath ? (
          <Scene3D client:only="react" modelPath={modelPath} lang={lang} />
        ) : (
          <div class="w-full h-full flex items-center justify-center">
            <p class="text-xl text-base-content">
              {t("experience.modelNotFound.message")}
            </p>
          </div>
        )
      }
    </div>

    <div
      class="experience-instructions absolute bottom-4 left-1/2 -translate-x-1/2 z-50 px-4 sm:px-6 py-2 sm:py-3 rounded-full max-w-[90%] sm:max-w-none"
    >
      <p class="text-xs sm:text-sm text-center">
        {t("artifact.instructions")}
      </p>
    </div>
  </div>
</ExperienceLayout>

<style>
  :global(body) {
    overflow: hidden;
  }

  .experience-container {
    background: linear-gradient(
      to bottom,
      var(--color-deep-earth),
      oklch(20% 0.03 40),
      var(--color-deep-earth)
    );
  }

  .experience-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: oklch(95% 0 0);
    background: oklch(100% 0 0 / 0.08);
    backdrop-filter: blur(16px);
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .experience-btn:hover {
    background: oklch(100% 0 0 / 0.15);
    border-color: oklch(100% 0 0 / 0.2);
  }

  .experience-instructions {
    background: oklch(100% 0 0 / 0.08);
    backdrop-filter: blur(16px);
    border: 1px solid oklch(100% 0 0 / 0.1);
    color: oklch(90% 0 0);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const resetButton = document.getElementById("resetView");
    const autoRotateButton = document.getElementById("toggleAutoRotate");
    let isAutoRotating = false;

    if (resetButton) {
      resetButton.addEventListener("click", () => {
        const event = new CustomEvent("reset-camera");
        window.dispatchEvent(event);
      });
    }

    if (autoRotateButton) {
      autoRotateButton.addEventListener("click", () => {
        isAutoRotating = !isAutoRotating;
        const event = new CustomEvent("toggle-auto-rotate", {
          detail: { enabled: isAutoRotating },
        });
        window.dispatchEvent(event);
        autoRotateButton.textContent = isAutoRotating
          ? (autoRotateButton.dataset.labelActive || "Stop Rotation")
          : (autoRotateButton.dataset.labelInactive || "Auto Rotate");
      });
    }
  });
</script>
