---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/home/HeroSection.astro";
import QuoteSection from "../../components/home/QuoteSection.astro";
import FeaturedCollections from "../../components/home/FeaturedCollections.astro";
import TechnologySection from "../../components/home/TechnologySection.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<Layout title={t("home.title")} description={t("home.description")} lang={lang}>
  <HeroSection lang={lang} />
  <QuoteSection lang={lang} />
  <FeaturedCollections lang={lang} />
  <TechnologySection lang={lang} />
</Layout>
