---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/home/HeroSection.astro';
import IntroductionSection from '../../components/home/IntroductionSection.astro';
import FeaturedCollections from '../../components/home/FeaturedCollections.astro';
import TechnologySection from '../../components/home/TechnologySection.astro';
import StatsSection from '../../components/home/StatsSection.astro';
import FinalCTASection from '../../components/home/FinalCTASection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Language } from '../../types';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<Layout title={t('home.title')} description={t('home.description')} lang={lang}>
	<main id="main-content">
		<HeroSection lang={lang} />
		<IntroductionSection lang={lang} />
		<FeaturedCollections lang={lang} />
		<TechnologySection lang={lang} />
		<StatsSection lang={lang} />
		<FinalCTASection lang={lang} />
	</main>
</Layout>
