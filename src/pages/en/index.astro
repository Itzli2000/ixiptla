---
import Layout from '../../layouts/Layout.astro';
import Hero3DInteractive from '../../components/features/Hero3DInteractive/Hero3DInteractive.astro';
import Collection from '../../components/features/Collection/Collection.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import type { Language } from '../../types';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<Layout title={t('home.title')} description={t('home.description')} lang={lang}>
	<Hero3DInteractive />
	<Collection />	
</Layout>
