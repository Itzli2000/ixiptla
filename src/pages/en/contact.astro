---
import Layout from '../../layouts/Layout.astro';
import ContactHeader from '../../components/contact/ContactHeader.astro';
import ContactCard from '../../components/contact/ContactCard.astro';
import ContactReasonCard from '../../components/contact/ContactReasonCard.astro';
import { contactDataEn } from '../../data/contact';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const { hero, contactInfo } = contactDataEn;
---

<Layout title={hero.title} description={hero.description} lang={lang}>
  <main class="min-h-screen bg-base-100">
    <ContactHeader
      title={hero.title}
      subtitle={hero.subtitle}
      description={hero.description}
      lang={lang}
    />

    <div class="container mx-auto px-4 pb-16">
      <section class="my-16">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl lg:text-4xl font-light text-base-content mb-6 font-serif">
            {contactInfo.introduction.title}
          </h2>
          <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl mx-auto">
            {contactInfo.introduction.description}
          </p>
        </div>
      </section>

      <section class="mb-16">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-6">
            <h2 class="text-3xl font-light text-base-content mb-4 font-serif">
              {t('contact.methods.title')}
            </h2>
            <p class="text-base-content/60 max-w-2xl mx-auto">
              {t('contact.methods.description')}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {contactInfo.methods.map((method) => (
              <ContactCard method={method} />
            ))}
          </div>
        </div>
      </section>

      <section class="mb-16">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-light text-base-content mb-4 font-serif">
              {t('contact.reasons.title')}
            </h2>
            <p class="text-base-content/60 max-w-2xl mx-auto">
              {t('contact.reasons.description')}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {contactInfo.reasons.map((reason) => (
              <ContactReasonCard reason={reason} />
            ))}
          </div>
        </div>
      </section>

      <section class="max-w-4xl mx-auto">
        <div class="card bg-gradient-to-r from-primary/5 to-accent/5 shadow-lg">
          <div class="card-body p-8 text-center">
            <h3 class="text-2xl font-light text-base-content mb-4 font-serif">
              {t('contact.about.title')}
            </h3>
            <p class="text-base-content/70 leading-relaxed mb-6">
              {t('contact.about.description')}
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <span class="badge badge-primary badge-lg">Maya</span>
              <span class="badge badge-secondary badge-lg">Mexica</span>
              <span class="badge badge-accent badge-lg">Acolhua</span>
              <span class="badge badge-primary badge-lg">Mixteca</span>
              <span class="badge badge-secondary badge-lg">Teotihuacán</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .font-serif {
    font-family: 'Playfair Display', serif;
  }

  h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  section {
    padding: clamp(2rem, 8vw, 2rem) 0;
  }

  section:first-of-type {
    padding-top: 0;
  }

  .container {
    max-width: 1200px;
  }
</style>
