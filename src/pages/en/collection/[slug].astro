---
import { getCollection, getEntry } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import Layout from "../../../layouts/Layout.astro";
import type { Language } from "../../../types";

// New enhanced components
import ArtifactHero from "../../../components/artifact/ArtifactHero.astro";
import ArtifactMetadata from "../../../components/artifact/ArtifactMetadata.astro";
import CulturalContext from "../../../components/artifact/CulturalContext.astro";
import RelatedArtifacts from "../../../components/artifact/RelatedArtifacts.astro";
import BreadcrumbNavigation from "../../../components/ui/BreadcrumbNavigation.astro";
import ArtifactNavigation from "../../../components/artifact/ArtifactNavigation.astro";
import BackToTopButton from "../../../components/ui/BackToTopButton.astro";
import type { BreadcrumbItem } from "../../../types/artifact";

interface Props {
  params: {
    slug: string;
  };
}

export async function getStaticPaths() {
  const artifacts = await getCollection('artifacts');
  return artifacts.map((artifact) => ({
    params: { slug: artifact.data.slug },
  }));
}

const { slug } = Astro.params;
const artifacts = await getCollection('artifacts');
const { data: artifact } = await getEntry('artifacts', slug);

// Get related artifacts (same culture + different cultures)
const sameCultureArtifacts = artifacts
  .filter((a) => a.data.culture === artifact.culture && a.data.slug !== artifact.slug)
  .slice(0, 3);

const differentCultureArtifacts = artifacts
  .filter((a) => a.data.culture !== artifact.culture)
  .slice(0, 3);

const allRelatedArtifacts = [...sameCultureArtifacts, ...differentCultureArtifacts];

// Navigation artifacts
const currentIndex = artifacts.findIndex((a) => a.data.slug === artifact.slug);
const prevArtifact = currentIndex > 0 ? artifacts[currentIndex - 1] : null;
const nextArtifact = currentIndex < artifacts.length - 1 ? artifacts[currentIndex + 1] : null;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// SEO and metadata
const title = t('seo.artifact.titleTemplate')
  .replace('{title}', artifact.title)
  .replace('{culture}', artifact.culture);

const description = t('seo.artifact.descriptionTemplate')
  .replace('{title}', artifact.title)
  .replace('{culture}', artifact.culture)
  .replace('{period}', artifact.period)
  .replace('{description}', artifact.description.slice(0, 120) + '...');

// URLs
let canonicalURL: string | URL = `/en/collection/${artifact.slug}`;
let imageURL: string | URL = artifact.image;
let alternateURLs: { en: string | URL; es: string | URL } = {
  en: `/en/collection/${artifact.slug}`,
  es: `/es/coleccion/${artifact.slug}`,
};

if (Astro.site) {
  canonicalURL = new URL(`/en/collection/${artifact.slug}`, Astro.site);
  imageURL = new URL(`/images/${artifact.image}`, Astro.site);
  alternateURLs = {
    en: new URL(`/en/collection/${artifact.slug}`, Astro.site),
    es: new URL(`/es/coleccion/${artifact.slug}`, Astro.site),
  };
} else {
  imageURL = `/images/${artifact.image}`;
}

// Breadcrumb navigation
const breadcrumbItems: BreadcrumbItem[] = [
  { label: t("artifact.home"), href: `/${lang}#collection` },
  { label: t("artifact.collection"), href: `/${lang}/collection` },
  { label: artifact.title, current: true, ariaCurrent: "page" }
];
---

<Layout 
  title={title} 
  description={description} 
  lang={lang}
  image={imageURL}
  canonicalURL={canonicalURL}
  alternateURLs={alternateURLs}
  currentArtifact={artifact}
>
  <main class="min-h-screen">
    <!-- Skip to content link for accessibility -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary text-primary-content px-4 py-2 rounded-lg z-50"
    >
      {t("artifact.accessibility.skipToContent")}
    </a>

    <!-- Breadcrumb Navigation -->
    <section class="pt-20 sm:pt-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-base-100/5 to-transparent">
      <div class="max-w-7xl mx-auto">
        <BreadcrumbNavigation items={breadcrumbItems} lang={lang} t={t} />
      </div>
    </section>

    <!-- Hero Section -->
    <section id="main-content" class="px-4 sm:px-6 lg:px-8" aria-labelledby="artifact-title">
      <div class="max-w-7xl mx-auto">
        <ArtifactHero artifact={artifact} lang={lang} t={t} />
      </div>
    </section>

    <!-- Artifact Metadata -->
    <section class="px-4 sm:px-6 lg:px-8 py-16 lg:py-24" aria-labelledby="metadata-title">
      <div class="max-w-7xl mx-auto">
        <ArtifactMetadata artifact={artifact} lang={lang} t={t} />
      </div>
    </section>

    <!-- Cultural Context -->
    <section class="px-4 sm:px-6 lg:px-8 py-16 lg:py-24 bg-gradient-to-b from-base-100/5 to-base-200/10" aria-labelledby="cultural-context-title">
      <CulturalContext artifact={artifact} lang={lang} t={t} />
    </section>

    <!-- Related Artifacts -->
    <section class="px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-base-200/10 to-base-100/5" aria-labelledby="related-artifacts-title">
      <RelatedArtifacts 
        relatedArtifacts={allRelatedArtifacts} 
        currentCulture={artifact.culture} 
        lang={lang} 
        t={t} 
      />
    </section>

    <!-- Navigation Between Artifacts -->
    <ArtifactNavigation 
      prevArtifact={prevArtifact}
      nextArtifact={nextArtifact}
      lang={lang}
      t={t}
    />

    <!-- Back to top button -->
    <BackToTopButton lang={lang} t={t} />
  </main>
</Layout>

<style>
  /* Custom scrollbar for better UX */
  html {
    scroll-behavior: smooth;
  }
  
  /* Improved focus styles */
  a:focus-visible, button:focus-visible {
    outline: 2px solid rgb(var(--primary));
    outline-offset: 2px;
  }
  
  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>