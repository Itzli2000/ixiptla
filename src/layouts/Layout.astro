---
import { ClientRouter } from "astro:transitions";
import Navigation from '../components/layout/Navigation/Navigation.astro';
import '../styles/global.css';
import type { LayoutProps, Language } from '../types';
import { useTranslations } from '../i18n/utils';

interface Props extends LayoutProps {}

const {
  title,
  description,
  lang = "en" as Language,
  image,
  canonicalURL,
  alternateURLs,
  currentArtifact
} = Astro.props;

const ogImage = image || `/images/og-image-${lang}.png`;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname.replace(/^\/?/, "/");
const siteUrl = canonicalURL?.toString() || (Astro.site
  ? new URL(currentPath, Astro.site).toString()
  : currentPath);

// SEO data from translations
const seoData = {
  siteName: t('seo.site.name'),
  siteDescription: t('seo.site.description'),
  author: t('seo.site.author'),
  keywords: t('seo.site.keywords')
};

// Generate keywords for current page
let pageKeywords = seoData.keywords;
if (currentArtifact) {
  const artifactKeywords = t('seo.artifact.keywordsTemplate')
    .replace('{culture}', currentArtifact.culture)
    .replace('{period}', currentArtifact.period)
    .replace('{material}', currentArtifact.material || '');
  pageKeywords = `${artifactKeywords}, ${seoData.keywords}`;
}

// Structured data for the site
const structuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      "url": Astro.site?.toString(),
      "name": seoData.siteName,
      "description": seoData.siteDescription,
      "inLanguage": lang,
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${Astro.site}${lang}/coleccion?search={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${Astro.site}#organization`,
      "name": seoData.siteName,
      "description": seoData.siteDescription,
      "url": Astro.site?.toString(),
      "logo": {
        "@type": "ImageObject",
        "url": `${Astro.site}favicon.svg`
      },
      "sameAs": []
    }
  ]
};

// Add Cultural Object structured data for artifacts
if (currentArtifact) {
  structuredData["@graph"].push({
    "@type": "CulturalObject",
    "@id": `${siteUrl}#artifact`,
    "name": currentArtifact.title,
    "description": currentArtifact.description,
    "dateCreated": currentArtifact.period,
    "material": currentArtifact.material,
    "artMedium": currentArtifact.technique,
    "image": new URL(currentArtifact.image, Astro.site).href,
    "about": currentArtifact.culture,
    "isPartOf": {
      "@type": "Collection",
      "name": seoData.siteName
    },
    "maintainer": {
      "@id": `${Astro.site}#organization`
    }
  });
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="theme-color" content="#2c5364" />
		
		<!-- Favicon and Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		
		<!-- Performance optimizations -->
		<link rel="dns-prefetch" href="//fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{currentArtifact?.has3DModel && (
			<link rel="prefetch" href={`/images/models/${currentArtifact.slug}.glb`} as="fetch" crossorigin />
		)}
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={pageKeywords} />
		<meta name="author" content={seoData.author} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow" />
		
		<!-- Generator and Site Info -->
		<meta name="generator" content={Astro.generator} />
		<meta name="application-name" content={seoData.siteName} />
		<meta name="msapplication-TileColor" content="#2c5364" />
		
		<!-- Canonical and Language -->
		<link rel="canonical" href={siteUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		{alternateURLs && Object.entries(alternateURLs).map(([langCode, url]) => (
			<link rel="alternate" hreflang={langCode} href={url.toString()} />
		))}
		<link rel="alternate" hreflang="x-default" href={alternateURLs?.en?.toString() || siteUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={currentArtifact ? "article" : "website"} />
		<meta property="og:site_name" content={seoData.siteName} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, siteUrl).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
		{alternateURLs && Object.entries(alternateURLs).map(([langCode, url]) => (
			langCode !== lang && (
				<meta property="og:locale:alternate" content={langCode === 'es' ? 'es_MX' : 'en_US'} />
			)
		))}
		
		{currentArtifact && (
			<>
				<meta property="article:section" content={currentArtifact.culture} />
				<meta property="article:tag" content={currentArtifact.period} />
				<meta property="article:tag" content={currentArtifact.material || ''} />
				<meta property="article:author" content={seoData.author} />
			</>
		)}
	
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@ixiptla" />
		<meta name="twitter:creator" content="@ixiptla" />
		<meta name="twitter:url" content={siteUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
		<meta name="twitter:image:alt" content={currentArtifact ? `${currentArtifact.title} - ${currentArtifact.culture}` : seoData.siteName} />

		<!-- Additional SEO Meta Tags -->
		<meta name="revisit-after" content="7 days" />
		<meta name="rating" content="general" />
		<meta name="distribution" content="global" />
		<meta name="coverage" content="worldwide" />
		<meta name="target" content="all" />
		<meta name="audience" content="all" />
		
		<!-- Cultural/Museum specific meta tags -->
		<meta name="DC.type" content="Collection" />
		<meta name="DC.format" content="text/html" />
		<meta name="DC.identifier" content={siteUrl} />
		<meta name="DC.language" content={lang} />
		<meta name="DC.coverage" content="Mesoamerica" />
		<meta name="DC.subject" content="Archaeological replicas, Mesoamerican art, Cultural heritage" />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<ClientRouter />
	</head>
	<body class="bg-base-100 text-base-content">
		<Navigation />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
