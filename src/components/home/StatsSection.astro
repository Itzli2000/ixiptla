---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import { museumStats } from '../../data/museumStats';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="section-dark py-24 lg:py-32 relative overflow-hidden"
  aria-labelledby="stats-title"
>
  <!-- Dot grid pattern -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
    style="background-image: radial-gradient(circle at 1px 1px, oklch(95% 0.01 83.24 / 0.06) 1px, transparent 0); background-size: 24px 24px;">
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-20" data-reveal>
      <h2
        id="stats-title"
        class="text-4xl lg:text-5xl font-bold mb-6"
      >
        {t('home.stats.title')}
      </h2>
      <p class="text-xl lg:text-2xl opacity-70 font-light leading-relaxed mb-8">
        {t('home.stats.subtitle')}
      </p>
      <p class="text-lg opacity-80 leading-relaxed">
        {t('home.stats.description')}
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8" data-reveal-stagger>
      <!-- Artifacts Stat -->
      <div data-reveal class="glass text-center p-8 rounded-3xl hover:bg-[oklch(100%_0_0_/_0.08)] transition-all duration-500 group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-[var(--color-primary-rich)] bg-opacity-20 flex items-center justify-center transition-colors duration-300" style="background: oklch(from var(--color-primary-rich) l c h / 0.15);">
          <Icon name="mdi:arrow-right" class="w-8 h-8 text-[var(--color-gold-accent)]" />
        </div>
        <div class="mb-4">
          <div class="text-5xl lg:text-6xl font-bold text-[var(--color-gold-accent)] mb-2 tabular-nums" data-counter={`${museumStats.artifacts}+`}>
            0
          </div>
          <div class="text-lg font-semibold opacity-90">
            {t('home.stats.labels.artifacts')}
          </div>
        </div>
        <div class="w-full rounded-full h-1.5 overflow-hidden" style="background: oklch(100% 0 0 / 0.08);">
          <div class="h-full rounded-full bg-gradient-to-r from-[var(--color-primary-rich)] to-[var(--color-gold-accent)]" data-progress="100"></div>
        </div>
      </div>

      <!-- Cultures Stat -->
      <div data-reveal class="glass text-center p-8 rounded-3xl hover:bg-[oklch(100%_0_0_/_0.08)] transition-all duration-500 group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl flex items-center justify-center transition-colors duration-300" style="background: oklch(from var(--color-primary-rich) l c h / 0.15);">
          <Icon name="mdi:book-open-page-variant" class="w-8 h-8 text-[var(--color-gold-accent)]" />
        </div>
        <div class="mb-4">
          <div class="text-5xl lg:text-6xl font-bold text-[var(--color-gold-accent)] mb-2 tabular-nums" data-counter={`${museumStats.cultures}`}>
            0
          </div>
          <div class="text-lg font-semibold opacity-90">
            {t('home.stats.labels.cultures')}
          </div>
        </div>
        <div class="w-full rounded-full h-1.5 overflow-hidden" style="background: oklch(100% 0 0 / 0.08);">
          <div class="h-full rounded-full bg-gradient-to-r from-[var(--color-gold-accent)] to-[var(--color-primary-rich)]" data-progress="100"></div>
        </div>
      </div>

      <!-- 3D Models Stat -->
      <div data-reveal class="glass text-center p-8 rounded-3xl hover:bg-[oklch(100%_0_0_/_0.08)] transition-all duration-500 group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl flex items-center justify-center transition-colors duration-300" style="background: oklch(from var(--color-primary-rich) l c h / 0.15);">
          <Icon name="mdi:cube-scan" class="w-8 h-8 text-[var(--color-gold-accent)]" />
        </div>
        <div class="mb-4">
          <div class="text-5xl lg:text-6xl font-bold text-[var(--color-gold-accent)] mb-2 tabular-nums" data-counter={`${museumStats.models3D}+`}>
            0
          </div>
          <div class="text-lg font-semibold opacity-90">
            {t('home.stats.labels.models3D')}
          </div>
        </div>
        <div class="w-full rounded-full h-1.5 overflow-hidden" style="background: oklch(100% 0 0 / 0.08);">
          <div class="h-full rounded-full bg-gradient-to-r from-[var(--color-primary-rich)] to-[var(--color-gold-accent)]" data-progress="100"></div>
        </div>
      </div>

      <!-- Experience Stat -->
      <div data-reveal class="glass text-center p-8 rounded-3xl hover:bg-[oklch(100%_0_0_/_0.08)] transition-all duration-500 group">
        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl flex items-center justify-center transition-colors duration-300" style="background: oklch(from var(--color-primary-rich) l c h / 0.15);">
          <Icon name="mdi:eye" class="w-8 h-8 text-[var(--color-gold-accent)]" />
        </div>
        <div class="mb-4">
          <div class="text-3xl lg:text-4xl font-bold text-[var(--color-gold-accent)] mb-2">
            {t('home.common.experience')}
          </div>
          <div class="text-lg font-semibold opacity-90">
            {t('home.stats.labels.experiences')}
          </div>
        </div>
        <div class="w-full rounded-full h-1.5 overflow-hidden" style="background: oklch(100% 0 0 / 0.08);">
          <div class="h-full rounded-full bg-gradient-to-r from-[var(--color-gold-accent)] to-[var(--color-primary-rich)]" data-progress="100"></div>
        </div>
      </div>
    </div>

    <!-- Additional Info -->
    <div class="text-center mt-16" data-reveal>
      <p class="opacity-50 text-sm max-w-2xl mx-auto">
        {t('home.stats.additionalInfo')}
      </p>
    </div>
  </div>
</section>
