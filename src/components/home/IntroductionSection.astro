---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/languages/es.json';
import en from '../../i18n/languages/en.json';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const valueItems = translations.home.introduction.values.items;
---

<section 
  id="introduction"
  class="py-24 lg:py-32 section-elevated"
  aria-labelledby="introduction-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:pl-[10%] lg:pr-[20%]">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-20" data-reveal>
      <h2
        id="introduction-title"
        class="text-4xl lg:text-5xl font-medium text-base-content mb-6"
      >
        {t('home.introduction.title')}
      </h2>
      <p class="text-xl lg:text-2xl text-base-content/70 font-light leading-relaxed">
        {t('home.introduction.subtitle')}
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center mb-20">
      <!-- Description -->
      <div class="space-y-8" data-reveal>
        <p class="text-lg text-base-content/80 leading-relaxed">
          {t('home.introduction.description')}
        </p>

        <!-- Mission Statement -->
        <div class="p-8 rounded-sm border-l-4 border-l-(--color-primary-rich) bg-base-200">
          <h3 class="text-2xl font-medium text-primary mb-4">
            {t('home.introduction.mission.title')}
          </h3>
          <p class="text-base-content/80 leading-relaxed">
            {t('home.introduction.mission.content')}
          </p>
        </div>

        <!-- Vision Statement -->
        <div class="p-8 rounded-sm border-l-4 border-l-secondary bg-base-200">
          <h3 class="text-2xl font-medium text-secondary mb-4">
            {t('home.introduction.vision.title')}
          </h3>
          <p class="text-base-content/80 leading-relaxed">
            {t('home.introduction.vision.content')}
          </p>
        </div>
      </div>

      <!-- Values Grid -->
      <div class="space-y-8" data-reveal="right">
        <h3 class="text-3xl font-medium text-base-content mb-8">
          {t('home.introduction.values.title')}
        </h3>

        <div class="grid gap-6" data-reveal-stagger>
          {valueItems.map((value: { title: string; description: string }, index: number) => {
            const iconMap = [
              "mdi:heart",
              "mdi:check-circle",
              "mdi:earth",
              "mdi:lightning-bolt"
            ];
            const padded = String(index + 1).padStart(2, '0');

            return (
              <div
                data-reveal
                class="relative flex gap-4 p-6 hover:bg-base-200/30 transition-colors duration-300 overflow-hidden"
                style={`--reveal-index: ${index}`}
              >
                <div class="shrink-0 relative z-10">
                  <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center">
                    <Icon name={iconMap[index]} class="w-6 h-6 text-accent" />
                  </div>
                </div>
                <div class="flex-1 relative z-10">
                  <h4 class="text-xl font-semibold text-base-content mb-2">
                    {value.title}
                  </h4>
                  <p class="text-base-content/70 leading-relaxed">
                    {value.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center">
      <a 
        href={`/${lang}/contact`}
        class="btn btn-outline btn-lg border-primary text-primary hover:bg-primary hover:text-primary-content transition-all duration-300 rounded-sm group"
        aria-label={t('home.introduction.cta')}
      >
        <Icon name="mdi:book-open-page-variant" class="w-6 h-6 mr-2 group-hover:scale-110 transition-transform duration-300" />
        {t('home.introduction.cta')}
      </a>
    </div>
  </div>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Ixiptla Digital Museum",
    "description": t('home.introduction.description'),
    "url": `https://ixiptla.com/${lang}`,
    "logo": "https://ixiptla.com/images/logo.png",
    "foundingDate": "2024",
    "mission": t('home.introduction.mission.content'),
    "slogan": t('home.introduction.vision.content'),
    "areaServed": "Global",
    "audience": {
      "@type": "Audience",
      "audienceType": "Educational, Cultural, Academic"
    }
  })}></script>
</section>

<style>
  /* Animations handled by global data-reveal system */
</style>