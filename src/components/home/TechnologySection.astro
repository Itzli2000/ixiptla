---
import { useTranslations } from "../../i18n/utils";
import { technologyFeatures } from "../../data/technologyFeatures";
import { Scene3D } from "../three/Scene3D/Scene3D";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="py-24 lg:py-32 bg-base-100 relative overflow-hidden"
  aria-labelledby="technology-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-20">
      <h2
        id="technology-title"
        class="text-4xl lg:text-5xl font-bold text-base-content mb-6"
      >
        {t("home.technology.title")}
      </h2>
      <p
        class="text-xl lg:text-2xl text-base-content/70 font-light leading-relaxed mb-8"
      >
        {t("home.technology.subtitle")}
      </p>
      <p class="text-lg text-base-content/80 leading-relaxed">
        {t("home.technology.description")}
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center mb-20">
      <!-- Technology Features -->
      <div class="space-y-8">
        <div class="grid gap-6">
          {
            technologyFeatures.map((feature, index) => (
              <div
                class="tech-feature group p-6 rounded-2xl bg-gradient-to-br from-base-200/50 to-base-300/30 border border-base-300/50 hover:border-primary/30 hover:shadow-lg transition-all duration-500"
                style={`animation-delay: ${index * 0.1}s`}
              >
                <div class="flex items-start gap-4">
                  <div class="flex-shrink-0">
                    <div class="w-14 h-14 rounded-xl bg-primary/10 group-hover:bg-primary/20 flex items-center justify-center transition-colors duration-300">
                      <svg
                        class="w-7 h-7 text-primary"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        {feature.icon === "mdi:cube-scan" && (
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                          />
                        )}
                        {feature.icon === "mdi:magnify-scan" && (
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                          />
                        )}
                        {feature.icon === "mdi:book-open-page-variant" && (
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                          />
                        )}
                        {feature.icon === "mdi:earth" && (
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                          />
                        )}
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1">
                    <h3 class="text-xl font-semibold text-base-content mb-3 group-hover:text-primary transition-colors duration-300">
                      {feature.title}
                    </h3>
                    <p class="text-base-content/70 leading-relaxed">
                      {feature.description}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Visual Demo Area -->
      <div class="relative">
        <!-- Interactive Demo Card -->
        <div
          class="relative bg-gradient-to-br from-base-100 to-base-200 rounded-3xl p-8 shadow-2xl border border-base-300/50"
        >
          <!-- 3D Model Preview (React Island) -->
          <div class="mb-6 aspect-square">
            <Scene3D
            client:only="react"
              modelPath="/images/models/colibri.glb"
              lang={lang}
              initialModelScale={[3, 3, 3]}
            />
          </div>

          <!-- Interactive Features Guide -->
          <div class="space-y-4">
            <div class="flex items-center gap-3 p-3 rounded-lg bg-primary/5 border border-primary/20">
              <svg
                class="w-5 h-5 text-primary flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path>
              </svg>
              <div>
                <h4 class="text-sm font-medium text-primary">
                  {t("home.technology.demo.rotate")}
                </h4>
                <p class="text-xs text-base-content/70">
                  {t("home.technology.demo.rotateDesc")}
                </p>
              </div>
            </div>
            
            <div class="flex items-center gap-3 p-3 rounded-lg bg-secondary/5 border border-secondary/20">
              <svg
                class="w-5 h-5 text-secondary flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                ></path>
              </svg>
              <div>
                <h4 class="text-sm font-medium text-secondary">
                  {t("home.technology.demo.zoom")}
                </h4>
                <p class="text-xs text-base-content/70">
                  {t("home.technology.demo.zoomDesc")}
                </p>
              </div>
            </div>
            

          </div>
        </div>

        <!-- Floating Stats -->
        <div
          class="absolute -top-8 -right-8 bg-primary text-primary-content rounded-2xl p-4 shadow-xl"
        >
          <div class="text-center">
            <div class="text-2xl font-bold">25+</div>
            <div class="text-xs opacity-90">
              {t("home.technology.demo.models3D")}
            </div>
          </div>
        </div>

        <div
          class="absolute -bottom-8 -left-8 bg-secondary text-secondary-content rounded-2xl p-4 shadow-xl"
        >
          <div class="text-center">
            <div class="text-2xl font-bold">4K</div>
            <div class="text-xs opacity-90">
              {t("home.technology.demo.resolution")}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to Actions -->
    <div class="text-center space-y-6">
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={`/${lang}/${lang === "es" ? "coleccion" : "collection"}`}
          class="btn btn-primary btn-lg text-primary-content hover:btn-primary-focus transition-all duration-300 group"
          aria-label={t("home.technology.cta")}
        >
          <svg
            class="w-6 h-6 mr-2 group-hover:scale-110 transition-transform duration-300"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          {t("home.technology.cta")}
        </a>

        <a
          href={`/${lang}/${lang === "es" ? "contacto" : "contact"}`}
          class="btn btn-outline btn-lg border-base-content/20 text-base-content hover:bg-base-content hover:text-base-100 transition-all duration-300"
          aria-label={t("home.technology.learnMoreCTA")}
        >
          {t("home.technology.learnMoreCTA")}
        </a>
      </div>

      <p class="text-sm text-base-content/60 max-w-2xl mx-auto">
        {
          lang === "es"
            ? "Experimenta la convergencia entre tecnología moderna y patrimonio ancestral en nuestras experiencias 3D inmersivas."
            : "Experience the convergence of modern technology and ancestral heritage in our immersive 3D experiences."
        }
      </p>
    </div>
  </div>

  <!-- Background Decoration -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/3 -right-48 w-96 h-96 bg-primary/3 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-1/3 -left-48 w-96 h-96 bg-secondary/3 rounded-full blur-3xl"
    >
    </div>
  </div>

  <!-- Structured Data -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: t("home.technology.title"),
      description: t("home.technology.description"),
      author: {
        "@type": "Organization",
        name: "Ixiptla Digital Museum",
      },
      about: {
        "@type": "Thing",
        name: "3D Archaeological Visualization Technology",
      },
      applicationCategory: "Educational Technology",
      operatingSystem: "Web Browser",
      softwareRequirements: "Modern web browser with WebGL support",
    })}
  />
</section>

<style>
  .tech-feature {
    opacity: 0;
    transform: translateY(20px);
    animation: slideInUp 0.6s ease-out forwards;
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-feature {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>


