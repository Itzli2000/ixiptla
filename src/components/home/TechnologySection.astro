---
import { Icon } from 'astro-icon/components';
import { useTranslations } from "../../i18n/utils";
import es from "../../i18n/languages/es.json";
import en from "../../i18n/languages/en.json";
import { Scene3D } from "../three/Scene3D/Scene3D";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const technologyFeatures = translations.home.technology.features;
---

<section
  class="bg-(--oc-surface-container-lowest) py-32 px-8 lg:px-24"
  aria-labelledby="technology-title"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
    <!-- Left: Steps -->
    <div>
      <h3 id="technology-title" class="font-headline text-5xl font-bold mb-12">
        {t("home.technology.title")}
      </h3>
      <p class="text-stone-400 text-lg mb-12 leading-relaxed">
        {t("home.technology.subtitle")}
      </p>
      <div class="space-y-12">
        {
          technologyFeatures.map((feature, index) => (
            <div class="border-l-2 border-(--oc-primary-container) pl-8 py-2">
              <h5 class="font-label text-lg font-bold text-(--oc-primary) mb-2">
                {String(index + 1).padStart(2, "0")}. {feature.title}
              </h5>
              <p class="text-stone-400 text-sm leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Right: Tech demo -->
    <div class="relative bg-(--oc-surface-container-high) p-8 flex flex-col items-center">
      <div class="w-full aspect-video bg-(--oc-surface-container-lowest) relative overflow-hidden mb-8">
        <Scene3D
          client:visible
          modelPath="/images/models/colibri.glb"
          lang={lang}
          initialModelScale={[3, 3, 3]}
        />
      </div>
      <div class="grid grid-cols-3 gap-4 w-full">
        <div class="bg-(--oc-surface-container-lowest) p-4 text-center">
          <p class="font-label text-(--oc-primary) text-xl font-bold">25+</p>
          <p class="font-label text-[8px] text-stone-500 uppercase">{t("home.technology.stats.models")}</p>
        </div>
        <div class="bg-(--oc-surface-container-lowest) p-4 text-center">
          <p class="font-label text-(--oc-primary) text-xl font-bold">4K</p>
          <p class="font-label text-[8px] text-stone-500 uppercase">{t("home.technology.stats.resolution")}</p>
        </div>
        <div class="bg-(--oc-surface-container-lowest) p-4 text-center">
          <p class="font-label text-(--oc-primary) text-xl font-bold">0.1mm</p>
          <p class="font-label text-[8px] text-stone-500 uppercase">{t("home.technology.stats.precision")}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Structured Data -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: t("home.technology.title"),
      description: t("home.technology.subtitle"),
      author: {
        "@type": "Organization",
        name: "Ixiptla Digital Museum",
      },
      about: {
        "@type": "Thing",
        name: "3D Archaeological Visualization Technology",
      },
      applicationCategory: "Educational Technology",
      operatingSystem: "Web Browser",
      softwareRequirements: "Modern web browser with WebGL support",
    })}
  />
</section>
