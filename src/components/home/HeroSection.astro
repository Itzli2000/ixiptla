---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/languages/es.json';
import en from '../../i18n/languages/en.json';
import { getImageByFilename } from '../../utils/imageMapping';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const heroFeatures = translations.home.hero.features;
const heroImage = getImageByFilename('colibri.png');

const titleWords = t('home.hero.title').split(' ');
const titleLine1 = titleWords.slice(0, 2).join(' ');
const titleLine2 = titleWords.slice(2).join(' ');
---

<section
  class="hero-section relative min-h-screen flex items-center overflow-hidden"
  aria-label={t('home.hero.title')}
>
  <!-- Background Image with blend mode -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 flex justify-center items-center">
      <Image
        src={heroImage}
        alt={t('home.hero.imageAlt')}
        class="object-center opacity-25 mix-blend-multiply scale-110"
        loading="eager"
        fetchpriority="high"
        width={800}
        height={800}
      />
    </div>
    <!-- Gradient overlay for depth -->
    <div class="absolute inset-0 bg-gradient-to-b from-base-100/40 via-base-100/60 to-[var(--color-surface-sunken)]"></div>
    <!-- Noise texture overlay -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.03] pointer-events-none" aria-hidden="true">
      <filter id="hero-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/>
      </filter>
      <rect width="100%" height="100%" filter="url(#hero-noise)"/>
    </svg>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-24 lg:py-0">
    <div class="lg:grid lg:grid-cols-5 lg:gap-12 lg:items-center lg:min-h-screen">
      <!-- Text content: cols 1-3 -->
      <div class="lg:col-span-3 space-y-8 text-center lg:text-left">
        <!-- Badge -->
        <div data-reveal class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm">
          <Icon name="mdi:book-open-page-variant" class="w-5 h-5 text-primary" />
          <span class="text-sm font-medium text-primary">{t('home.hero.subtitle')}</span>
        </div>

        <!-- Main Headline -->
        <div data-reveal class="space-y-4">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-base-content leading-[1.1] tracking-tight">
            <span class="block hero-title-word">{titleLine1}</span>
            <span class="block text-primary hero-title-word">{titleLine2}</span>
          </h1>

          <p class="text-lg sm:text-xl lg:text-2xl text-base-content/70 max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed">
            {t('home.hero.description')}
          </p>
        </div>

        <!-- Feature Pills -->
        <div data-reveal data-reveal-stagger class="flex flex-col sm:flex-row sm:flex-wrap gap-3 justify-center lg:justify-start max-w-2xl mx-auto lg:mx-0">
          {heroFeatures.map((feature: string, i: number) => (
            <div
              data-reveal
              class="flex items-center gap-3 py-2 px-1 border-l-2 border-[var(--color-primary-rich)] pl-3"
              style={`--reveal-index: ${i}`}
            >
              <span class="text-sm text-base-content/80">{feature}</span>
            </div>
          ))}
        </div>

        <!-- CTA Buttons -->
        <div data-reveal class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center pt-4">
          <a
            href={`/${lang}/collection`}
            class="btn btn-primary btn-lg text-primary-content transition-all duration-300 group backdrop-blur-sm shadow-[var(--shadow-premium-glow)]"
            aria-label={t('home.hero.primaryCTA')}
          >
            <Icon name="mdi:arrow-right" class="w-6 h-6 mr-2 group-hover:translate-x-1 transition-transform duration-300" />
            {t('home.hero.primaryCTA')}
          </a>

          <a
            href="#introduction"
            class="btn btn-outline btn-lg border-base-content/20 text-base-content hover:bg-base-content hover:text-base-100 transition-all duration-300 backdrop-blur-sm"
            aria-label={t('home.hero.secondaryCTA')}
          >
            {t('home.hero.secondaryCTA')}
          </a>
        </div>
      </div>

      <!-- Image: cols 4-5 (desktop only) -->
      <div class="hidden lg:flex lg:col-span-2 items-center justify-center relative" data-reveal="scale">
        <div class="hero-image-container relative">
          <Image
            src={heroImage}
            alt={t('home.hero.imageAlt')}
            class="relative z-10 drop-shadow-2xl"
            width={500}
            height={500}
          />
          <!-- Glow behind image -->
          <div class="absolute inset-0 bg-[var(--color-primary-rich)] opacity-10 blur-3xl rounded-full scale-75 -z-0"></div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
      <a
        href="#introduction"
        class="inline-flex flex-col items-center gap-3 text-base-content/40 hover:text-base-content/70 transition-colors duration-500"
        aria-label={t('home.common.scrollDown')}
      >
        <span class="text-xs font-medium uppercase tracking-widest">{t('home.common.exploreMore')}</span>
        <div class="scroll-line w-px h-8 bg-gradient-to-b from-base-content/40 to-transparent relative overflow-hidden">
          <div class="absolute inset-0 w-full bg-base-content/80 animate-scroll-line"></div>
        </div>
      </a>
    </div>
  </div>

  <!-- Structured Data for SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": t('home.hero.title'),
    "description": t('home.hero.description'),
    "url": `https://ixiptla.com/${lang}`,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Ixiptla",
      "url": "https://ixiptla.com"
    },
    "about": {
      "@type": "Museum",
      "name": "Ixiptla Digital Museum",
      "description": "Virtual museum showcasing Mesoamerican archaeological replicas"
    }
  })}></script>
</section>

<style>
  .hero-section {
    background: linear-gradient(
      135deg,
      var(--color-surface-elevated) 0%,
      oklch(from var(--color-base-200) l c h / 0.8) 50%,
      var(--color-surface-sunken) 100%
    );
  }

  .hero-image-container {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes animate-scroll-line {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  .animate-scroll-line {
    animation: animate-scroll-line 1.5s ease-in-out infinite;
  }

  /* Optimize for Core Web Vitals */
  img {
    content-visibility: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image-container {
      animation: none;
    }
    .animate-scroll-line {
      animation: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const scrollLinks = document.querySelectorAll('a[href^="#"]');

    scrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.substring(1);
        const targetElement = targetId ? document.getElementById(targetId) : null;

        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  });
</script>
