---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/languages/es.json';
import en from '../../i18n/languages/en.json';
import { getImageByFilename } from '../../utils/imageMapping';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const heroFeatures = translations.home.hero.features;
const heroImage = getImageByFilename('colibri.png');
---

<section 
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-base-100 via-base-200 to-base-300"
  aria-label={t('home.hero.title')}
>
  <!-- Hero Background Image -->
  <div class="absolute inset-0 z-0 flex justify-center items-center">
    <Image
      src={heroImage}
      alt={t('home.hero.imageAlt')}
      class="object-center opacity-10"
      loading="eager"
      width={800}
      height={800}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-base-100/50 to-base-100/80"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20">
        <Icon name="mdi:book-open-page-variant" class="w-5 h-5 text-primary" />
        <span class="text-sm font-medium text-primary">{t('home.hero.subtitle')}</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-4">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-base-content leading-tight">
          <span class="block">{t('home.hero.title').split(' ').slice(0, 2).join(' ')}</span>
          <span class="block text-primary">{t('home.hero.title').split(' ').slice(2).join(' ')}</span>
        </h1>
        
        <p class="text-xl sm:text-2xl lg:text-3xl text-base-content/80 max-w-4xl mx-auto font-light leading-relaxed">
          {t('home.hero.description')}
        </p>
      </div>

      <!-- Feature List -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
        {heroFeatures.map((feature: string) => (
          <div class="flex items-center gap-3 p-4 rounded-lg bg-base-100/50 backdrop-blur-sm border border-base-300/50">
            <div class="flex-shrink-0">
              <Icon name="mdi:check" class="w-5 h-5 text-accent" />
            </div>
            <span class="text-sm font-medium text-base-content">{feature}</span>
          </div>
        ))}
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-8">
        <a 
          href={`/${lang}/${lang === 'es' ? 'coleccion' : 'collection'}`}
          class="btn btn-primary btn-lg text-primary-content hover:btn-primary-focus transition-all duration-300 group"
          aria-label={t('home.hero.primaryCTA')}
        >
          <Icon name="mdi:arrow-right" class="w-6 h-6 mr-2 group-hover:translate-x-1 transition-transform duration-300" />
          {t('home.hero.primaryCTA')}
        </a>
        
        <a 
          href="#introduction"
          class="btn btn-outline btn-lg border-base-content/20 text-base-content hover:bg-base-content hover:text-base-100 transition-all duration-300"
          aria-label={t('home.hero.secondaryCTA')}
        >
          {t('home.hero.secondaryCTA')}
        </a>
      </div>

      <!-- Scroll Indicator -->
      <div class="pt-16">
        <a 
          href="#introduction"
          class="inline-flex flex-col items-center gap-2 text-base-content/60 hover:text-base-content transition-colors duration-300"
          aria-label={t('home.common.scrollDown')}
        >
          <span class="text-sm font-medium">{t('home.common.exploreMore')}</span>
          <Icon name="mdi:chevron-down" class="w-6 h-6 animate-bounce" />
        </a>
      </div>
    </div>
  </div>

  <!-- Structured Data for SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": t('home.hero.title'),
    "description": t('home.hero.description'),
    "url": `https://ixiptla.com/${lang}`,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Ixiptla",
      "url": "https://ixiptla.com"
    },
    "about": {
      "@type": "Museum",
      "name": "Ixiptla Digital Museum",
      "description": "Virtual museum showcasing Mesoamerican archaeological replicas"
    }
  })}></script>
</section>

<style>
  /* Custom animation for hero elements */
  @media (prefers-reduced-motion: no-preference) {
    .hero-fade-in {
      animation: fadeInUp 0.8s ease-out forwards;
    }
    
    .hero-fade-in-delay {
      animation: fadeInUp 0.8s ease-out 0.2s forwards;
      opacity: 0;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Optimize for Core Web Vitals */
  img {
    content-visibility: auto;
  }
</style>

<script is:inline>
  // Progressive enhancement for smooth scrolling
  document.addEventListener('DOMContentLoaded', () => {
    const scrollLinks = document.querySelectorAll('a[href^="#"]');
    
    scrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.substring(1);
        const targetElement = targetId ? document.getElementById(targetId) : null;
        
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  });
</script>