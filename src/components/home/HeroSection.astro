---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/languages/es.json';
import en from '../../i18n/languages/en.json';
import { getImageByFilename } from '../../utils/imageMapping';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = lang === 'es' ? es : en;
const heroFeatures = translations.home.hero.features;
const heroImage = getImageByFilename('colibri.png');

const titleWords = t('home.hero.title').split(' ');
const titleMain = titleWords.slice(0, -1).join(' ');
const titleHighlight = titleWords[titleWords.length - 1];
---

<section
  class="min-h-screen flex items-center px-8 lg:px-24 mb-32"
  aria-label={t('home.hero.title')}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 w-full">
    <div class="lg:col-span-8 flex flex-col justify-center">
      <span class="font-label text-(--oc-tertiary) text-xs tracking-[0.4em] uppercase mb-6 block">
        {t('home.hero.subtitle')}
      </span>
      <h1 class="font-headline text-6xl md:text-8xl font-bold tracking-tighter text-(--oc-on-surface) leading-[0.9] mb-8">
        {titleMain} <span class="text-(--oc-primary) italic">{titleHighlight}</span>
      </h1>
      <p class="font-body text-xl text-(--oc-on-surface-variant) max-w-2xl leading-relaxed mb-10">
        {t('home.hero.description')}
      </p>
      <div class="flex gap-4">
        <a
          class="obsidian-gradient px-8 py-4 font-label text-sm font-bold uppercase tracking-widest text-(--oc-on-primary)"
          href={`/${lang}/collection`}
          aria-label={t('home.hero.primaryCTA')}
        >
          {t('home.hero.primaryCTA')}
        </a>
        <a
          class="px-8 py-4 font-label text-sm font-bold uppercase tracking-widest text-(--oc-tertiary) border border-transparent hover:bg-(--oc-surface-container-high)"
          href="#introduction"
          aria-label={t('home.hero.secondaryCTA')}
        >
          {t('home.hero.secondaryCTA')}
        </a>
      </div>
    </div>
    <div class="lg:col-span-4 relative">
      <div class="aspect-[3/4] bg-(--oc-surface-container-low) overflow-hidden">
        <Image
          src={heroImage}
          alt={t('home.hero.imageAlt')}
          class="w-full h-full object-cover grayscale contrast-125 opacity-70"
          loading="eager"
          fetchpriority="high"
          width={600}
          height={800}
        />
      </div>
      <div class="absolute -bottom-6 -left-6 bg-(--oc-surface-container-highest) p-6 max-w-[200px]">
        <p class="font-label text-[10px] text-(--oc-tertiary) uppercase mb-2">Artifact_Ref</p>
        <p class="font-label text-xs font-bold leading-tight">{t('home.hero.subtitle')}</p>
      </div>
    </div>
  </div>

  <!-- Structured Data for SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": t('home.hero.title'),
    "description": t('home.hero.description'),
    "url": `https://ixiptla.com/${lang}`,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Ixiptla",
      "url": "https://ixiptla.com"
    },
    "about": {
      "@type": "Museum",
      "name": "Ixiptla Digital Museum",
      "description": "Virtual museum showcasing Mesoamerican archaeological replicas"
    }
  })}></script>
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const scrollLinks = document.querySelectorAll('a[href^="#"]');

    scrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href')?.substring(1);
        const targetElement = targetId ? document.getElementById(targetId) : null;

        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  });
</script>
