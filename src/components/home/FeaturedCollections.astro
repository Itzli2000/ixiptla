---
import { useTranslations } from '../../i18n/utils';
import { cultureData, getCulturesWithArtifacts } from '../../data/cultureData';
import { getCultureLink, formatArtifactCount } from '../../utils/homeHelpers';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const availableCultures = getCulturesWithArtifacts();
---

<section 
  class="py-24 lg:py-32 bg-gradient-to-br from-base-200 to-base-300"
  aria-labelledby="featured-collections-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-20">
      <h2 
        id="featured-collections-title"
        class="text-4xl lg:text-5xl font-bold text-base-content mb-6"
      >
        {t('home.featuredCollections.title')}
      </h2>
      <p class="text-xl lg:text-2xl text-base-content/70 font-light leading-relaxed mb-8">
        {t('home.featuredCollections.subtitle')}
      </p>
      <p class="text-lg text-base-content/80 leading-relaxed">
        {t('home.featuredCollections.description')}
      </p>
    </div>

    <!-- Culture Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {availableCultures.map((culture, index) => {
        const cultureLink = getCultureLink(culture, lang);
        const artifactCountText = formatArtifactCount(culture.artifactCount, lang);
        
        return (
          <article 
            class="culture-card group relative overflow-hidden rounded-2xl bg-base-100 border border-base-300 hover:border-primary/50 shadow-lg hover:shadow-xl transition-all duration-500"
            style={`--culture-color: ${culture.color}; animation-delay: ${index * 0.1}s`}
          >
            <!-- Culture Icon Header -->
            <div class="relative p-8 pb-6 bg-gradient-to-br from-base-100 to-base-200 group-hover:from-primary/5 group-hover:to-primary/10 transition-all duration-500">
              <div class="flex items-center justify-between mb-4">
                <div class="w-16 h-16 rounded-xl bg-primary/10 group-hover:bg-primary/20 flex items-center justify-center transition-colors duration-300">
                  <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {culture.icon === 'mdi:pyramid' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l9 18H3l9-18z"/>
                    )}
                    {culture.icon === 'mdi:shield-sun' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3a9 9 0 00-9 9c0 2.5 1 4.8 2.6 6.4L12 21l6.4-2.6C20 16.8 21 14.5 21 12a9 9 0 00-9-9zm0 0v18"/>
                    )}
                    {culture.icon === 'mdi:temple-buddhist' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l-1.5 4.5h-7L12 21l8.5-13.5h-7L12 3z"/>
                    )}
                    {culture.icon === 'mdi:diamond-stone' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 3h12l4 6-10 12L2 9l4-6z"/>
                    )}
                    {culture.icon === 'mdi:city' && (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1"/>
                    )}
                  </svg>
                </div>
                <div class="text-right">
                  <div class="text-sm text-base-content/60 mb-1">{artifactCountText}</div>
                  <div class="text-xs text-primary font-medium px-2 py-1 rounded-full bg-primary/10">
                    {t('home.featuredCollections.available')}
                  </div>
                </div>
              </div>
              
              <h3 class="text-2xl font-bold text-base-content mb-3 group-hover:text-primary transition-colors duration-300">
                {culture.name}
              </h3>
              
              <p class="text-base-content/70 leading-relaxed">
                {culture.description}
              </p>
            </div>

            <!-- Card Actions -->
            <div class="p-6 pt-0">
              <div class="flex gap-3">
                <a 
                  href={cultureLink}
                  class="flex-1 btn btn-outline btn-sm border-primary/30 text-primary hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300"
                  aria-label={`${t('home.featuredCollections.exploreCollectionCTA')} ${culture.name}`}
                >
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  {t('home.featuredCollections.exploreCollectionCTA')}
                </a>
                
                <button 
                  class="btn btn-ghost btn-sm text-base-content/60 hover:text-base-content"
                  aria-label={`${t('home.featuredCollections.learnMore')} ${culture.name}`}
                  data-culture={culture.id}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Hover Effect Overlay -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          </article>
        );
      })}
    </div>

    <!-- View All CTA -->
    <div class="text-center">
      <a 
        href={`/${lang}/${lang === 'es' ? 'coleccion' : 'collection'}`}
        class="btn btn-primary btn-lg text-primary-content hover:btn-primary-focus transition-all duration-300 group"
        aria-label={t('home.featuredCollections.viewAllCTA')}
      >
        <svg class="w-6 h-6 mr-2 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4 4m4-4l-4-4"/>
        </svg>
        {t('home.featuredCollections.viewAllCTA')}
      </a>
    </div>
  </div>

  <!-- Culture Info Modal -->
  <div id="culture-modal" class="modal">
    <div class="modal-box max-w-2xl">
      <h3 id="modal-title" class="font-bold text-2xl mb-4"></h3>
      <div id="modal-content" class="space-y-4">
        <div id="modal-description" class="text-base-content/80"></div>
        <div class="divider"></div>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <strong class="text-base-content/70">{t('home.featuredCollections.modal.artifacts')}</strong>
            <div id="modal-artifacts" class="text-base-content"></div>
          </div>
          <div>
            <strong class="text-base-content/70">{t('home.featuredCollections.modal.period')}</strong>
            <div id="modal-period" class="text-base-content"></div>
          </div>
        </div>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn">{t('home.featuredCollections.modal.close')}</button>
        </form>
        <a id="modal-explore-link" href="#" class="btn btn-primary">
          {t('home.featuredCollections.exploreCollectionCTA')}
        </a>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </div>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t('home.featuredCollections.title'),
    "description": t('home.featuredCollections.description'),
    "url": `https://ixiptla.com/${lang}#featured-collections`,
    "mainEntity": {
      "@type": "ItemList",
      "name": "Mesoamerican Cultures",
      "itemListElement": availableCultures.map((culture, index) => ({
        "@type": "Thing",
        "position": index + 1,
        "name": culture.name,
        "description": culture.description,
        "url": `https://ixiptla.com${getCultureLink(culture, lang)}`
      }))
    }
  })}></script>
</section>

<style>
  .culture-card {
    transform: translateY(20px);
    opacity: 0;
    animation: slideInUp 0.6s ease-out forwards;
  }

  @keyframes slideInUp {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .culture-card {
      transform: none;
      opacity: 1;
      animation: none;
    }
  }
</style>

<script is:inline>
  // Culture info modal functionality
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('culture-modal');
    const cultureData = {
      'maya': {
        name: 'Maya',
        description: 'Advanced astronomical and mathematical civilization with sophisticated writing system and architectural achievements.',
        artifacts: '15',
        period: 'Classic Period (250-900 CE)'
      },
      'mexica': {
        name: 'Mexica',
        description: 'Powerful empire builders known for their military prowess, trade networks, and architectural marvels.',
        artifacts: '12', 
        period: 'Postclassic Period (1345-1521 CE)'
      },
      'acolhua': {
        name: 'Acolhua',
        description: 'Refined culture known for poetry, philosophy, and architectural innovations in the Valley of Mexico.',
        artifacts: '8',
        period: 'Postclassic Period (1200-1521 CE)'
      },
      'mixteca': {
        name: 'Mixteca',
        description: 'Master craftsmen renowned for their goldwork, codices, and sophisticated artistic traditions.',
        artifacts: '10',
        period: 'Classic-Postclassic (700-1521 CE)'
      },
      'teotihuacan': {
        name: 'Teotihuacan',
        description: 'Mysterious civilization that built one of the largest cities in the ancient world.',
        artifacts: '6',
        period: 'Classic Period (100-650 CE)'
      }
    };

    // Handle learn more buttons
    document.querySelectorAll('[data-culture]').forEach(button => {
      button.addEventListener('click', (e) => {
        const cultureId = e.currentTarget.getAttribute('data-culture');
        const culture = cultureData[cultureId];
        
        if (culture && modal) {
          document.getElementById('modal-title').textContent = culture.name;
          document.getElementById('modal-description').textContent = culture.description;
          document.getElementById('modal-artifacts').textContent = culture.artifacts;
          document.getElementById('modal-period').textContent = culture.period;
          
          const exploreLink = document.getElementById('modal-explore-link');
          exploreLink.href = `/${window.location.pathname.includes('/en/') ? 'en' : 'es'}/${window.location.pathname.includes('/en/') ? 'collection' : 'coleccion'}?culture=${cultureId}`;
          
          modal.showModal();
        }
      });
    });
  });
</script>