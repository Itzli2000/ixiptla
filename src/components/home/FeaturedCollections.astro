---
import { useTranslations } from '../../i18n/utils';
import { cultureData, getCulturesWithArtifacts } from '../../data/cultureData';
import { getCultureLink, formatArtifactCount } from '../../utils/homeHelpers';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const availableCultures = getCulturesWithArtifacts();
---

<section
  class="px-8 lg:px-24 mb-48"
  aria-labelledby="featured-collections-title"
>
  <!-- Header -->
  <div class="flex items-end justify-between mb-16" data-reveal>
    <div>
      <span class="font-label text-stone-500 text-xs tracking-widest uppercase block mb-4">
        {t('home.featuredCollections.title')}
      </span>
      <h3 id="featured-collections-title" class="font-headline text-5xl font-bold text-(--oc-on-surface)">
        {lang === 'es' ? 'Colecciones Destacadas' : 'Featured Collections'}
      </h3>
    </div>
    <a
      href={`/${lang}/collection`}
      class="font-label text-xs text-stone-600 underline cursor-pointer hover:text-(--oc-primary) transition-colors duration-300"
      aria-label={t('home.featuredCollections.viewAllCTA')}
    >
      {t('home.featuredCollections.viewAllCTA')}
    </a>
  </div>

  <!-- Culture Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
    {availableCultures.map((culture, index) => {
      const cultureLink = getCultureLink(culture, lang);
      const artifactCountText = formatArtifactCount(culture.artifactCount, lang);

      return (
        <article
          data-reveal
          class="bg-(--oc-surface-container-low) group cursor-pointer relative overflow-hidden"
          style={`--reveal-index: ${index}`}
        >
          <!-- Image placeholder -->
          <div class="relative aspect-square overflow-hidden">
            <div class="w-full h-full bg-(--oc-surface-container-lowest) grayscale group-hover:scale-105 group-hover:grayscale-0 transition-transform duration-700 opacity-60"></div>
            <div class="absolute inset-0 bg-linear-to-t from-(--oc-surface-container-lowest) to-transparent opacity-60"></div>
            <span class="font-label text-xs bg-(--oc-surface-container-lowest) px-2 py-1 text-(--oc-tertiary) absolute top-4 right-4">
              {artifactCountText}
            </span>
          </div>

          <!-- Content -->
          <div class="p-8">
            <h4 class="font-headline text-3xl font-bold text-(--oc-on-surface) mb-4">
              <a href={cultureLink} class="hover:text-(--oc-primary) transition-colors duration-300">
                {culture.name}
              </a>
            </h4>
            <p class="font-body text-sm text-stone-400 mb-6 leading-relaxed">
              {culture.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {culture.tags?.map((tag: string) => (
                <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                  {tag}
                </span>
              ))}
              {!culture.tags && (
                <>
                  <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                    {culture.name}
                  </span>
                  <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                    {lang === 'es' ? 'Mesoamérica' : 'Mesoamerica'}
                  </span>
                </>
              )}
            </div>
          </div>

          <!-- Info button -->
          <button
            class="absolute bottom-8 right-8 font-label text-[10px] text-stone-500 hover:text-(--oc-primary) transition-colors duration-300"
            aria-label={`${t('home.featuredCollections.learnMore')} ${culture.name}`}
            data-culture={culture.id}
          >
            <span class="material-symbols-outlined text-base">info</span>
          </button>
        </article>
      );
    })}
  </div>

  <!-- Culture Info Modal -->
  <div id="culture-modal" class="modal" role="dialog" aria-labelledby="modal-title">
    <div class="modal-box max-w-2xl bg-(--oc-surface-container) text-(--oc-on-surface)">
      <h3 id="modal-title" class="font-headline font-bold text-2xl mb-4"></h3>
      <div id="modal-content" class="space-y-4">
        <div id="modal-description" class="font-body text-sm text-stone-400 leading-relaxed"></div>
        <div class="grid grid-cols-2 gap-4 text-sm mt-6">
          <div>
            <strong class="font-label text-xs text-stone-500 block mb-1">{t('home.featuredCollections.modal.artifacts')}</strong>
            <div id="modal-artifacts" class="font-body text-(--oc-on-surface)"></div>
          </div>
          <div>
            <strong class="font-label text-xs text-stone-500 block mb-1">{t('home.featuredCollections.modal.period')}</strong>
            <div id="modal-period" class="font-body text-(--oc-on-surface)"></div>
          </div>
        </div>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="font-label text-xs text-stone-500 hover:text-(--oc-on-surface) transition-colors duration-300">{t('home.featuredCollections.modal.close')}</button>
        </form>
        <a id="modal-explore-link" href="#" class="font-label text-xs text-(--oc-primary) underline hover:text-(--oc-on-surface) transition-colors duration-300">
          {t('home.featuredCollections.exploreCollectionCTA')}
        </a>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </div>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t('home.featuredCollections.title'),
    "description": t('home.featuredCollections.description'),
    "url": `https://ixiptla.com/${lang}#featured-collections`,
    "mainEntity": {
      "@type": "ItemList",
      "name": "Mesoamerican Cultures",
      "itemListElement": availableCultures.map((culture, index) => ({
        "@type": "Thing",
        "position": index + 1,
        "name": culture.name,
        "description": culture.description,
        "url": `https://ixiptla.com${getCultureLink(culture, lang)}`
      }))
    }
  })}></script>
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('culture-modal');
    const cultureData = {
      'maya': {
        name: 'Maya',
        description: 'Advanced astronomical and mathematical civilization with sophisticated writing system and architectural achievements.',
        artifacts: '15',
        period: 'Classic Period (250-900 CE)'
      },
      'mexica': {
        name: 'Mexica',
        description: 'Powerful empire builders known for their military prowess, trade networks, and architectural marvels.',
        artifacts: '12',
        period: 'Postclassic Period (1345-1521 CE)'
      },
      'acolhua': {
        name: 'Acolhua',
        description: 'Refined culture known for poetry, philosophy, and architectural innovations in the Valley of Mexico.',
        artifacts: '8',
        period: 'Postclassic Period (1200-1521 CE)'
      },
      'mixteca': {
        name: 'Mixteca',
        description: 'Master craftsmen renowned for their goldwork, codices, and sophisticated artistic traditions.',
        artifacts: '10',
        period: 'Classic-Postclassic (700-1521 CE)'
      },
      'teotihuacan': {
        name: 'Teotihuacan',
        description: 'Mysterious civilization that built one of the largest cities in the ancient world.',
        artifacts: '6',
        period: 'Classic Period (100-650 CE)'
      }
    };

    // Handle learn more buttons
    document.querySelectorAll('[data-culture]').forEach(button => {
      button.addEventListener('click', (e) => {
        const cultureId = e.currentTarget.getAttribute('data-culture');
        const culture = cultureData[cultureId];

        if (culture && modal) {
          document.getElementById('modal-title').textContent = culture.name;
          document.getElementById('modal-description').textContent = culture.description;
          document.getElementById('modal-artifacts').textContent = culture.artifacts;
          document.getElementById('modal-period').textContent = culture.period;

          const exploreLink = document.getElementById('modal-explore-link');
          const pathLang = window.location.pathname.split('/')[1] || 'es';
          exploreLink.href = `/${pathLang}/collection?culture=${cultureId}`;

          modal.showModal();
        }
      });
    });
  });
</script>
