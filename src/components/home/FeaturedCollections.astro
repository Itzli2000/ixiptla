---
import { useTranslations } from '../../i18n/utils';
import { cultureData, getCulturesWithArtifacts } from '../../data/cultureData';
import { getCultureLink, formatArtifactCount } from '../../utils/homeHelpers';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const availableCultures = getCulturesWithArtifacts();
---

<section
  class="px-4 sm:px-8 lg:px-24 mb-48"
  aria-labelledby="featured-collections-title"
>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-16" data-reveal>
    <div>
      <span class="font-label text-stone-500 text-xs tracking-widest uppercase block mb-4">
        {t('home.featuredCollections.title')}
      </span>
      <h3 id="featured-collections-title" class="font-headline text-3xl sm:text-5xl font-bold text-(--oc-on-surface)">
        {t('home.featuredCollections.subtitle')}
      </h3>
    </div>
    <a
      href={`/${lang}/collection`}
      class="font-label text-xs text-stone-600 underline cursor-pointer hover:text-(--oc-primary) transition-colors duration-300 shrink-0"
      aria-label={t('home.featuredCollections.viewAllCTA')}
    >
      {t('home.featuredCollections.viewAllCTA')}
    </a>
  </div>

  <!-- Culture Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-stagger>
    {availableCultures.map((culture, index) => {
      const cultureLink = getCultureLink(culture, lang);
      const artifactCountText = formatArtifactCount(culture.artifactCount, lang);

      return (
        <a
          href={cultureLink}
          data-reveal
          class="bg-(--oc-surface-container-low) group block relative overflow-hidden hover:bg-(--oc-surface-bright) transition-colors duration-300"
          style={`--reveal-index: ${index}`}
          aria-label={`${t('home.featuredCollections.exploreCollectionCTA')} ${culture.name}`}
        >
          <!-- Culture Image -->
          <div class="relative aspect-square overflow-hidden bg-(--oc-surface-container-lowest)">
            <img
              src={culture.image}
              alt={culture.name}
              class="w-full h-full object-contain grayscale opacity-60 group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-80 transition-all duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-(--oc-surface-container-lowest) to-transparent opacity-60"></div>
            <span class="font-label text-xs bg-(--oc-surface-container-lowest) px-2 py-1 text-(--oc-tertiary) absolute top-4 right-4">
              {artifactCountText}
            </span>
          </div>

          <!-- Content -->
          <div class="p-8">
            <h4 class="font-headline text-3xl font-bold text-(--oc-on-surface) mb-4 group-hover:text-(--oc-primary) transition-colors duration-300">
              {culture.name}
            </h4>
            <p class="font-body text-sm text-stone-400 mb-6 leading-relaxed">
              {t('home.featuredCollections.cultures.' + culture.id) !== 'home.featuredCollections.cultures.' + culture.id
                ? t('home.featuredCollections.cultures.' + culture.id)
                : culture.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {culture.tags?.map((tag: string) => (
                <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                  {tag}
                </span>
              ))}
              {!culture.tags && (
                <>
                  <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                    {culture.name}
                  </span>
                  <span class="px-2 py-1 bg-(--oc-surface-container-lowest) font-label text-[10px] text-stone-500">
                    {t('home.featuredCollections.regionTag')}
                  </span>
                </>
              )}
            </div>
          </div>

        </a>
      );
    })}
  </div>

  <!-- Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": t('home.featuredCollections.title'),
    "description": t('home.featuredCollections.description'),
    "url": `https://ixiptla.com/${lang}#featured-collections`,
    "mainEntity": {
      "@type": "ItemList",
      "name": "Mesoamerican Cultures",
      "itemListElement": availableCultures.map((culture, index) => ({
        "@type": "Thing",
        "position": index + 1,
        "name": culture.name,
        "description": culture.description,
        "url": `https://ixiptla.com${getCultureLink(culture, lang)}`
      }))
    }
  })}></script>
</section>
