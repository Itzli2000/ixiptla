---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "../../i18n/utils";
import { getImageByFilename } from "../../utils/imageMapping";
import type { Language } from "../../types";

interface Props {
  relatedArtifacts: Array<{
    data: {
      title: string;
      culture: string;
      period: string;
      image: string;
      description: string;
      slug: string;
      has3DModel?: boolean;
    };
  }>;
  currentCulture: string;
  lang: Language;
  t: (key: string) => string;
}

const { relatedArtifacts, currentCulture, lang, t } = Astro.props;

// Group related artifacts by type
const sameCultureArtifacts = relatedArtifacts.filter(artifact =>
  artifact.data.culture === currentCulture
);

const differentCultureArtifacts = relatedArtifacts.filter(artifact =>
  artifact.data.culture !== currentCulture
);

const hasRelatedArtifacts = relatedArtifacts.length > 0;

// Combine all for display, prioritizing same culture
const displayArtifacts = [...sameCultureArtifacts, ...differentCultureArtifacts].slice(0, 4);
---

{hasRelatedArtifacts && (
  <section class="p-8 lg:p-24 bg-(--oc-surface-container-lowest)" role="region" aria-labelledby="related-artifacts-title">
    <h3 id="related-artifacts-title" class="font-headline text-3xl font-bold mb-12 text-(--oc-on-surface)">
      {t("artifact.related.title")} <span class="italic text-(--oc-tertiary)">{currentCulture}</span>
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {displayArtifacts.map((artifact) => {
        const artifactImage = getImageByFilename(artifact.data.image);
        return (
          <a
            href={`/${lang}/collection/${artifact.data.slug}`}
            class="relative group bg-(--oc-surface-container-low) h-100 overflow-hidden block"
          >
            <Image
              src={artifactImage}
              alt={artifact.data.title}
              width={800}
              height={600}
              class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-700"
              transition:name={`artifact-${artifact.data.slug}`}
            />
            <div class="absolute inset-0 p-10 flex flex-col justify-end bg-linear-to-t from-(--oc-background) to-transparent">
              <p class="font-label text-[10px] uppercase tracking-widest text-(--oc-primary) mb-2">{artifact.data.culture}</p>
              <h4 class="font-headline text-3xl font-bold text-(--oc-on-surface)">{artifact.data.title}</h4>
              <span class="mt-4 font-label text-[10px] uppercase tracking-widest text-(--oc-on-surface-variant) group-hover:text-(--oc-primary) flex items-center gap-2 transition-colors duration-300">
                {t("artifact.related.viewAll")} <Icon name="mdi:arrow-right" class="w-4 h-4" />
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Explore More CTA -->
    <div class="mt-16 flex flex-col sm:flex-row gap-4">
      <a
        href={`/${lang}/collection`}
        class="inline-flex items-center gap-2 bg-(--oc-surface-container-highest) text-(--oc-on-surface) px-8 py-3 font-label text-[10px] uppercase tracking-[0.2em] hover:bg-(--oc-surface-bright) transition-colors border border-(--oc-outline-variant)/30"
      >
        <Icon name="mdi:view-grid" class="w-4 h-4" />
        {t("artifact.related.exploreMore")}
      </a>
      <a
        href={`/${lang}/collection?culture=${currentCulture}`}
        class="inline-flex items-center gap-2 bg-(--oc-surface-container-highest) text-(--oc-on-surface) px-8 py-3 font-label text-[10px] uppercase tracking-[0.2em] hover:bg-(--oc-surface-bright) transition-colors border border-(--oc-outline-variant)/30"
      >
        <Icon name="mdi:filter" class="w-4 h-4" />
        {t("artifact.related.sameCulture").replace('{culture}', currentCulture)}
      </a>
    </div>
  </section>
)}

{!hasRelatedArtifacts && (
  <section class="p-8 lg:p-24 bg-(--oc-surface-container-lowest)" role="region">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-(--oc-surface-container-low) p-12">
        <Icon name="mdi:magnify" class="w-16 h-16 text-stone-500 mx-auto mb-6" />
        <h2 class="font-headline text-2xl font-bold text-(--oc-on-surface) mb-4">
          {t("artifact.related.noRelated")}
        </h2>
        <p class="font-body text-(--oc-on-surface-variant) mb-8 max-w-2xl mx-auto">
          {t("artifact.related.noRelatedDescription")}
        </p>
        <a
          href={`/${lang}/collection`}
          class="inline-flex items-center gap-2 bg-linear-to-tr from-(--oc-primary) to-(--oc-primary-container) text-(--oc-on-primary) px-10 py-4 font-label uppercase tracking-widest text-xs font-bold transition-transform active:scale-95"
        >
          <Icon name="mdi:view-grid" class="w-5 h-5" />
          {t("collection.cta")}
        </a>
      </div>
    </div>
  </section>
)}
