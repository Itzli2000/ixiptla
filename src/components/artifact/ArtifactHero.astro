---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getImageByFilename } from "../../utils/imageMapping";
import { getModelForSlug } from "../../data/models";
import type { Language } from "../../types";

interface Props {
  artifact: {
    title: string;
    culture: string;
    period: string;
    image: string;
    description: string;
    slug: string;
    museum: string;
    location: string;
    has3DModel?: boolean;
  };
  lang: Language;
  t: (key: string) => string;
}

const { artifact, lang, t } = Astro.props;
const image = getImageByFilename(artifact.image);
const model3D = getModelForSlug(artifact.slug);
---

<section class="grid grid-cols-1 lg:grid-cols-12 min-h-150">
  <!-- Artifact Visual Column -->
  <div class="lg:col-span-7 bg-(--oc-surface-container-lowest) relative overflow-hidden group">
    <div class="absolute inset-0 bg-linear-to-tr from-(--oc-background) via-transparent to-transparent z-10"></div>
    <Image
      src={image}
      alt={artifact.title}
      width={1200}
      height={900}
      class="w-full h-full object-cover grayscale brightness-75 transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105"
      transition:name={`artifact-${artifact.slug}`}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute bottom-8 left-8 z-20 flex flex-col gap-2">
      <h2 class="text-(--oc-surface-container-highest) text-8xl font-black font-headline opacity-10 leading-none uppercase">{artifact.culture}</h2>
    </div>
  </div>

  <!-- Content Panel Column -->
  <div class="lg:col-span-5 bg-(--oc-background) p-8 lg:p-16 flex flex-col justify-center border-l border-(--oc-outline-variant)/15">
    <h1 class="font-headline text-5xl lg:text-7xl font-bold tracking-tighter text-(--oc-on-surface) leading-tight mb-6">
      {artifact.title}
    </h1>

    <!-- Tags -->
    <div class="flex flex-wrap gap-4 mb-8">
      <div class="bg-(--oc-surface-container-high) px-4 py-2 flex items-center gap-2">
        <Icon name="mdi:earth" class="text-(--oc-tertiary) text-sm w-4 h-4" />
        <span class="font-label text-xs uppercase tracking-widest text-(--oc-on-surface-variant)">{artifact.culture}</span>
      </div>
      <div class="bg-(--oc-surface-container-high) px-4 py-2 flex items-center gap-2">
        <Icon name="mdi:clock-outline" class="text-(--oc-tertiary) text-sm w-4 h-4" />
        <span class="font-label text-xs uppercase tracking-widest text-(--oc-on-surface-variant)">{artifact.period}</span>
      </div>
    </div>

    <!-- Description -->
    <p class="font-body text-(--oc-on-surface-variant) text-lg leading-relaxed mb-12 max-w-lg">
      {artifact.description}
    </p>

    <!-- Technical Specs Grid -->
    <div class="grid grid-cols-2 gap-px bg-(--oc-outline-variant)/15">
      <div class="bg-(--oc-surface-container-lowest) p-6">
        <p class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">{t("artifact.metadata.period")}</p>
        <p class="font-label text-sm text-(--oc-on-surface)">{artifact.period}</p>
      </div>
      <div class="bg-(--oc-surface-container-lowest) p-6">
        <p class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">{t("artifact.metadata.culture")}</p>
        <p class="font-label text-sm text-(--oc-on-surface)">{artifact.culture}</p>
      </div>
      <div class="bg-(--oc-surface-container-lowest) p-6">
        <p class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">{t("artifact.metadata.location")}</p>
        <p class="font-label text-sm text-(--oc-on-surface)">{artifact.museum}</p>
      </div>
      <div class="bg-(--oc-surface-container-lowest) p-6">
        <p class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">{t("artifact.metadata.location")}</p>
        <p class="font-label text-sm text-(--oc-on-surface)">{artifact.location}</p>
      </div>
    </div>

    <!-- 3D Experience CTA -->
    {model3D && (
      <div class="mt-12">
        <a
          href={`/${lang}/experience/${model3D}`}
          class="inline-flex items-center gap-3 bg-linear-to-tr from-(--oc-primary) to-(--oc-primary-container) text-(--oc-on-primary) px-10 py-4 font-label uppercase tracking-widest text-xs font-bold transition-transform active:scale-95"
          aria-label={`${t("artifact.experience.cta")} - ${artifact.title}`}
        >
          <Icon name="mdi:cube-outline" class="w-5 h-5" />
          {t("artifact.experience.cta")}
        </a>
      </div>
    )}
  </div>
</section>
