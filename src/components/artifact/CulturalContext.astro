---
import { Icon } from "astro-icon/components";
import type { Language } from "../../types";

interface Props {
  artifact: {
    title: string;
    culture: string;
    period: string;
    description: string;
    museum: string;
    location: string;
  };
  lang: Language;
  t: (key: string) => string;
}

const { artifact, lang, t } = Astro.props;

const cultureKey = artifact.culture === 'Teotihuacan' ? 'Teotihuacan' : artifact.culture;
const culturalContext = {
  significance: t(`artifact.culturalContexts.${cultureKey}.significance`),
  artistry: t(`artifact.culturalContexts.${cultureKey}.artistry`),
  legacy: t(`artifact.culturalContexts.${cultureKey}.legacy`),
};
---

<section class="bg-(--oc-surface-container-lowest) p-8 lg:p-24" role="region">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="mb-16" data-reveal>
      <p class="font-label text-xs uppercase tracking-[0.4em] text-(--oc-tertiary) mb-4">{t("artifact.context.subtitle")}</p>
      <h2 class="font-headline text-4xl lg:text-5xl font-bold text-(--oc-on-surface)">
        {t("artifact.context.title")}
      </h2>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Primary Content (2 cols) -->
      <div class="lg:col-span-2 space-y-12">
        <!-- Artifact Description -->
        <div data-reveal>
          <h3 class="font-headline text-2xl font-bold text-(--oc-on-surface) mb-4 flex items-center gap-3">
            <Icon name="mdi:scroll-text" class="w-6 h-6 text-(--oc-primary)" />
            {t("artifact.context.description")}
          </h3>
          <p class="font-body text-(--oc-on-surface-variant) text-lg leading-relaxed">
            {artifact.description}
          </p>
        </div>

        <!-- Historical Significance -->
        <div class="bg-(--oc-surface-container-low) p-8 border-l-2 border-(--oc-tertiary)" data-reveal>
          <h3 class="font-headline text-2xl font-bold text-(--oc-on-surface) mb-4 flex items-center gap-3">
            <Icon name="mdi:book-open-page-variant" class="w-6 h-6 text-(--oc-tertiary)" />
            {t("artifact.context.historicalSignificance")}
          </h3>
          <p class="font-body text-(--oc-on-surface-variant) leading-relaxed">
            {culturalContext.significance}
          </p>
        </div>

        <!-- Artistic Context -->
        <div class="bg-(--oc-surface-container-low) p-8 border-l-2 border-(--oc-primary)" data-reveal>
          <h3 class="font-headline text-2xl font-bold text-(--oc-on-surface) mb-4 flex items-center gap-3">
            <Icon name="mdi:palette" class="w-6 h-6 text-(--oc-primary)" />
            {t("artifact.context.culturalImportance")}
          </h3>
          <p class="font-body text-(--oc-on-surface-variant) leading-relaxed">
            {culturalContext.artistry}
          </p>
        </div>
      </div>

      <!-- Sidebar (1 col) -->
      <div class="space-y-8">
        <!-- Culture Info Card -->
        <div class="bg-(--oc-surface-container-low) p-6 border-l-2 border-(--oc-tertiary)" data-reveal>
          <h4 class="font-label text-xs uppercase tracking-widest font-bold text-(--oc-on-surface) mb-4 flex items-center gap-2">
            <Icon name="mdi:temple-hindu" class="w-5 h-5 text-(--oc-tertiary)" />
            {artifact.culture}
          </h4>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <Icon name="mdi:calendar" class="w-4 h-4 text-stone-500" />
              <span class="font-label text-xs text-(--oc-on-surface-variant)">{artifact.period}</span>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="mdi:map-marker" class="w-4 h-4 text-stone-500 mt-0.5" />
              <div>
                <div class="font-label text-xs text-(--oc-on-surface)">{artifact.museum}</div>
                <div class="font-label text-[10px] text-stone-500">{artifact.location}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Legacy Impact -->
        <div class="bg-(--oc-surface-container-low) p-6 border-l-2 border-(--oc-tertiary)" data-reveal>
          <h4 class="font-label text-xs uppercase tracking-widest font-bold text-(--oc-on-surface) mb-4 flex items-center gap-2">
            <Icon name="mdi:timeline" class="w-5 h-5 text-(--oc-tertiary)" />
            {t("artifact.context.culturalLegacy")}
          </h4>
          <p class="font-body text-sm text-(--oc-on-surface-variant) leading-relaxed">
            {culturalContext.legacy}
          </p>
        </div>

        <!-- Educational Resources -->
        <div class="bg-(--oc-surface-container-low) p-6" data-reveal>
          <h4 class="font-label text-xs uppercase tracking-widest font-bold text-(--oc-on-surface) mb-4 flex items-center gap-2">
            <Icon name="mdi:school" class="w-5 h-5 text-(--oc-primary)" />
            {t("artifact.context.educationalResources")}
          </h4>
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <Icon name="mdi:book" class="w-4 h-4 text-stone-500" />
              <span class="font-label text-[10px] uppercase tracking-widest text-(--oc-on-surface-variant)">{t("artifact.context.historicalContextResource")}</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="mdi:map" class="w-4 h-4 text-stone-500" />
              <span class="font-label text-[10px] uppercase tracking-widest text-(--oc-on-surface-variant)">{t("artifact.context.geographicLocation")}</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="mdi:account-group" class="w-4 h-4 text-stone-500" />
              <span class="font-label text-[10px] uppercase tracking-widest text-(--oc-on-surface-variant)">{t("artifact.context.socialContext")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="mt-16 pt-8" data-reveal>
      <p class="font-body text-(--oc-on-surface-variant) mb-6">
        {t("artifact.context.exploreCTA")}
      </p>
      <a
        href={`/${lang}/collection?culture=${artifact.culture}`}
        class="inline-flex items-center gap-2 bg-linear-to-tr from-(--oc-primary) to-(--oc-primary-container) text-(--oc-on-primary) px-10 py-4 font-label uppercase tracking-widest text-xs font-bold transition-transform active:scale-95"
      >
        <Icon name="mdi:arrow-right" class="w-5 h-5" />
        {t("artifact.related.exploreMore")}
      </a>
    </div>
  </div>
</section>
