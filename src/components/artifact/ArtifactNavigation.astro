---
import { Icon } from "astro-icon/components";
import type { Language } from "../../types";

interface Props {
  prevArtifact: {
    data: {
      title: string;
      culture: string;
      slug: string;
    };
  } | null;
  nextArtifact: {
    data: {
      title: string;
      culture: string;
      slug: string;
    };
  } | null;
  lang: Language;
  t: (key: string) => string;
}

const { prevArtifact, nextArtifact, lang, t } = Astro.props;

const collectionPath = "collection";
---

<!-- Navigation Between Artifacts -->
<section class="px-4 sm:px-6 lg:px-8 py-12 section-sunken">
  <div class="max-w-7xl mx-auto">
    <nav class="flex flex-col sm:flex-row justify-between items-center gap-4" aria-label={t("artifact.navigation.breadcrumb")}>
      {prevArtifact ? (
        <a
          href={`/${lang}/${collectionPath}/${prevArtifact.data.slug}`}
          class="nav-card group w-full justify-around sm:w-auto flex items-center gap-3 rounded-xl px-6 py-4 max-w-sm"
          aria-label={`${t("artifact.navigation.previous")}: ${prevArtifact.data.title}`}
        >
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <Icon name="mdi:arrow-left-bold" />
          </div>
          <div class="text-left">
            <div class="text-xs text-base-content/60 mb-1">{t("artifact.navigation.previous")}</div>
            <div class="font-medium text-base-content truncate">{prevArtifact.data.title}</div>
            <div class="text-xs text-base-content/60">{prevArtifact.data.culture}</div>
          </div>
        </a>
      ) : (
        <div></div>
      )}

      {nextArtifact ? (
        <a
          href={`/${lang}/${collectionPath}/${nextArtifact.data.slug}`}
          class="nav-card group w-full justify-around sm:w-auto flex items-center gap-3 rounded-xl px-6 py-4 max-w-sm"
          aria-label={`${t("artifact.navigation.next")}: ${nextArtifact.data.title}`}
        >
          <div class="text-right">
            <div class="text-xs text-base-content/60 mb-1">{t("artifact.navigation.next")}</div>
            <div class="font-medium text-base-content truncate">{nextArtifact.data.title}</div>
            <div class="text-xs text-base-content/60">{nextArtifact.data.culture}</div>
          </div>
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
            <Icon name="mdi:arrow-right-bold" />
          </div>
        </a>
      ) : (
        <div></div>
      )}
    </nav>
  </div>
</section>

<style>
  .nav-card {
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-premium);
    transition: transform 0.4s var(--ease-expo-out),
      box-shadow 0.4s var(--ease-expo-out);
  }

  .nav-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-premium-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-card {
      transition: none;
    }
    .nav-card:hover {
      transform: none;
    }
  }
</style>
