---
import { Icon } from "astro-icon/components";
import type { Language } from "../../types";

interface Props {
  artifact: {
    culture: string;
    period: string;
    location: string;
    museum: string;
    dimensions?: string;
    material?: string;
    technique?: string;
  };
  lang: Language;
  t: (key: string) => string;
}

const { artifact, lang, t } = Astro.props;
---

<section class="bg-(--oc-surface-container-lowest) p-8 lg:p-24" data-reveal>
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="mb-12">
      <p class="font-label text-xs uppercase tracking-[0.4em] text-(--oc-tertiary) mb-4">{t("artifact.technicalInfo")}</p>
      <h2 class="font-headline text-4xl lg:text-5xl font-bold text-(--oc-on-surface)">
        {t("artifact.context.craftsmanshipDetails")}
      </h2>
    </div>

    <!-- Metadata Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-(--oc-outline-variant)/15">
      <!-- Cultural Information -->
      <div class="space-y-px bg-(--oc-outline-variant)/15">
        <!-- Culture -->
        <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-tertiary)">
          <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
            {t("artifact.metadata.culture")}
          </dt>
          <dd class="font-label text-sm text-(--oc-on-surface)">
            {artifact.culture}
          </dd>
        </div>

        <!-- Period -->
        <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-tertiary)">
          <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
            {t("artifact.metadata.period")}
          </dt>
          <dd class="font-label text-sm text-(--oc-on-surface)">
            {artifact.period}
          </dd>
        </div>

        <!-- Location -->
        <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-tertiary)">
          <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
            {t("artifact.metadata.location")}
          </dt>
          <dd class="font-label text-sm text-(--oc-on-surface)">
            {artifact.museum}
          </dd>
          <dd class="font-label text-xs text-stone-500 mt-1">
            {artifact.location}
          </dd>
        </div>
      </div>

      <!-- Technical Information -->
      <div class="space-y-px bg-(--oc-outline-variant)/15">
        <!-- Dimensions -->
        {artifact.dimensions && (
          <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-primary)">
            <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
              {t("artifact.metadata.dimensions")}
            </dt>
            <dd class="font-label text-sm text-(--oc-on-surface)">
              {artifact.dimensions}
            </dd>
          </div>
        )}

        <!-- Material -->
        {artifact.material && (
          <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-primary)">
            <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
              {t("artifact.metadata.material")}
            </dt>
            <dd class="font-label text-sm text-(--oc-on-surface)">
              {artifact.material}
            </dd>
          </div>
        )}

        <!-- Technique -->
        {artifact.technique && (
          <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-primary)">
            <dt class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
              {t("artifact.metadata.technique")}
            </dt>
            <dd class="font-label text-sm text-(--oc-on-surface)">
              {artifact.technique}
            </dd>
          </div>
        )}

        <!-- Fallback when no technical details -->
        {!artifact.dimensions && !artifact.material && !artifact.technique && (
          <div class="bg-(--oc-surface-container-lowest) p-6 border-l-2 border-(--oc-primary)">
            <p class="font-label text-[10px] uppercase tracking-widest text-stone-500 mb-1">
              {t("artifact.context.historicalSignificance")}
            </p>
          </div>
        )}
      </div>
    </div>

    <!-- Additional Context -->
    <div class="mt-px bg-(--oc-surface-container-low) p-8 border-l-2 border-(--oc-tertiary)">
      <h3 class="font-label text-sm uppercase tracking-widest font-bold text-(--oc-on-surface) mb-3 flex items-center gap-3">
        <Icon name="mdi:book-open-outline" class="w-5 h-5 text-(--oc-tertiary)" />
        {t("artifact.context.archaeologicalContext")}
      </h3>
      <p class="font-body text-(--oc-on-surface-variant) leading-relaxed">
        {t("artifact.metadata.archaeologicalNote")}
      </p>
    </div>
  </div>
</section>
