---
import { Icon } from "astro-icon/components";
import type { Language } from "../../types";

interface Props {
  artifact: {
    culture: string;
    period: string;
    location: string;
    museum: string;
    dimensions?: string;
    material?: string;
    technique?: string;
  };
  lang: Language;
  t: (key: string) => string;
}

const { artifact, lang, t } = Astro.props;
---

<section class="metadata-section rounded-3xl p-8 lg:p-12" data-reveal>
  <!-- Section Header -->
  <div class="mb-8">
    <h2
      class="text-3xl lg:text-4xl font-normal text-base-content mb-3 flex items-center gap-4"
      style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -0.01em;"
    >
      <Icon name="mdi:information-outline" class="w-8 h-8 text-primary" />
      {t("artifact.technicalInfo")}
    </h2>
    <div class="w-16 h-1 bg-gradient-to-r from-primary to-secondary rounded-full" aria-hidden="true"></div>
  </div>

  <!-- Metadata Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Cultural Information -->
    <div class="space-y-6">
      <h3 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-3">
        <Icon name="mdi:temple-buddhist" class="w-5 h-5 text-primary" />
        {t("artifact.context.culturalImportance")}
      </h3>

      <dl class="space-y-4">
        <!-- Culture -->
        <div class="metadata-item rounded-xl p-4">
          <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
            {t("artifact.metadata.culture")}
          </dt>
          <dd class="text-lg font-semibold text-base-content">
            {artifact.culture}
          </dd>
        </div>

        <!-- Period -->
        <div class="metadata-item rounded-xl p-4">
          <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
            {t("artifact.metadata.period")}
          </dt>
          <dd class="text-lg font-semibold text-base-content">
            {artifact.period}
          </dd>
        </div>

        <!-- Location -->
        <div class="metadata-item rounded-xl p-4">
          <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
            <Icon name="mdi:map-marker" class="w-4 h-4 inline mr-1" />
            {t("artifact.metadata.location")}
          </dt>
          <dd class="text-lg font-semibold text-base-content">
            {artifact.museum}
          </dd>
          <dd class="text-sm text-base-content/80 mt-1">
            {artifact.location}
          </dd>
        </div>
      </dl>
    </div>

    <!-- Technical Information -->
    <div class="space-y-6">
      <h3 class="text-xl font-semibold text-base-content mb-4 flex items-center gap-3">
        <Icon name="mdi:tools" class="w-5 h-5 text-primary" />
        {t("artifact.context.craftsmanshipDetails")}
      </h3>

      <dl class="space-y-4">
        <!-- Dimensions -->
        {artifact.dimensions && (
          <div class="metadata-item rounded-xl p-4">
            <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
              <Icon name="mdi:ruler" class="w-4 h-4 inline mr-1" />
              {t("artifact.metadata.dimensions")}
            </dt>
            <dd class="text-lg font-semibold text-base-content">
              {artifact.dimensions}
            </dd>
          </div>
        )}

        <!-- Material -->
        {artifact.material && (
          <div class="metadata-item rounded-xl p-4">
            <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
              <Icon name="mdi:material-design" class="w-4 h-4 inline mr-1" />
              {t("artifact.metadata.material")}
            </dt>
            <dd class="text-lg font-semibold text-base-content">
              {artifact.material}
            </dd>
          </div>
        )}

        <!-- Technique -->
        {artifact.technique && (
          <div class="metadata-item rounded-xl p-4">
            <dt class="text-sm font-medium text-base-content/70 uppercase tracking-wider mb-2">
              <Icon name="mdi:hand-extended" class="w-4 h-4 inline mr-1" />
              {t("artifact.metadata.technique")}
            </dt>
            <dd class="text-lg font-semibold text-base-content">
              {artifact.technique}
            </dd>
          </div>
        )}

        <!-- Placeholder for additional technical details -->
        {!artifact.dimensions && !artifact.material && !artifact.technique && (
          <div class="metadata-item rounded-xl p-6 text-center">
            <Icon name="mdi:information-outline" class="w-8 h-8 text-base-content/50 mx-auto mb-2" />
            <p class="text-base-content/60 text-sm">
              {t("artifact.context.historicalSignificance")}
            </p>
          </div>
        )}
      </dl>
    </div>
  </div>

  <!-- Additional Context Section -->
  <div class="mt-8 pt-8 border-t border-base-content/10">
    <div class="context-card rounded-2xl p-6">
      <h3 class="text-lg font-semibold text-base-content mb-3 flex items-center gap-2">
        <Icon name="mdi:book-open-outline" class="w-5 h-5 text-primary" />
        {t("artifact.context.archaeologicalContext")}
      </h3>
      <p class="text-base-content/80 leading-relaxed">
        {t("artifact.metadata.archaeologicalNote")}
      </p>
    </div>
  </div>
</section>

<style>
  .metadata-section {
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-premium);
  }

  .metadata-item {
    background: var(--color-surface-sunken);
    transition: transform 0.3s var(--ease-expo-out),
      box-shadow 0.3s var(--ease-expo-out);
  }

  .metadata-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-premium);
  }

  .context-card {
    background: var(--color-surface-sunken);
    border-left: 4px solid var(--color-primary-rich);
  }

  @media (prefers-reduced-motion: reduce) {
    .metadata-item {
      transition: none;
    }
    .metadata-item:hover {
      transform: none;
    }
  }
</style>
