---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  lang: 'en' | 'es';
}

const { title, subtitle, description, lang } = Astro.props;

const breadcrumbHome = lang === 'en' ? 'Home' : 'Inicio';
const breadcrumbContact = lang === 'en' ? 'Contact' : 'Contacto';
const homeUrl = lang === 'en' ? '/en' : '/';
---

<header class="relative py-16 lg:px-16 lg:py-24">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-base-100 via-base-200 to-base-100 opacity-50"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgb(0_0_0/0.15)_1px,transparent_0)] [background-size:20px_20px] opacity-30"></div>
  
  <div class="relative container mx-auto px-4">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-base-content/60 mb-8" aria-label="Breadcrumb">
      <a href={homeUrl} class="hover:text-primary transition-colors duration-200">
        {breadcrumbHome}
      </a>
      <Icon name="mdi:chevron-right" class="w-4 h-4" />
      <span class="text-base-content/80">{breadcrumbContact}</span>
    </nav>

    <!-- Header Content -->
    <div class="max-w-4xl">
      {subtitle && (
        <p class="text-primary font-medium text-sm uppercase tracking-wider mb-4">
          {subtitle}
        </p>
      )}
      
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-light text-base-content mb-6 leading-tight">
        <span class="font-serif">{title}</span>
      </h1>
      
      {description && (
        <p class="text-xl text-base-content/70 leading-relaxed max-w-3xl">
          {description}
        </p>
      )}
    </div>
  </div>
</header>

<style>
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  
  .font-serif {
    font-family: 'Playfair Display', serif;
  }
</style>