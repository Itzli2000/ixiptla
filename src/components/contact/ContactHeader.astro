---
import BreadcrumbNavigation from "../ui/BreadcrumbNavigation.astro";
import { useTranslations } from "../../i18n/utils";
import type { BreadcrumbItem } from "../../types/artifact";

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  lang: 'en' | 'es';
}

const { title, subtitle, description, lang } = Astro.props;
const t = useTranslations(lang);

const breadcrumbItems: BreadcrumbItem[] = [
  { label: t("navigation.home"), href: `/${lang}` },
  { label: t("navigation.contact"), current: true, ariaCurrent: "page" }
];
---

<header class="border-b border-(--oc-outline-variant)/15 pb-12 mb-24">
  <div class="mb-6">
    <BreadcrumbNavigation items={breadcrumbItems} lang={lang} t={t} />
  </div>

  <div class="flex flex-col md:flex-row justify-between items-end gap-8">
    <div class="max-w-3xl">
      {subtitle && (
        <span class="font-label text-(--oc-tertiary) uppercase tracking-[0.2em] text-xs mb-4 block">
          {subtitle}
        </span>
      )}
      <h1 class="font-headline text-6xl md:text-8xl font-bold tracking-tight text-(--oc-primary) leading-none uppercase">
        {title}
      </h1>
    </div>
    <div class="font-label text-(--oc-on-surface-variant) text-right text-xs uppercase tracking-widest leading-relaxed">
      Ref: IXP-CONTACT-2024<br />
      Status: {lang === 'es' ? 'Activo' : 'Active'}<br />
      {lang === 'es' ? 'Nodo: CDMX' : 'Location: CDMX Node'}
    </div>
  </div>
</header>
