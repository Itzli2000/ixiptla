---
import type { ContactReason } from '../../types/contact';

interface Props {
  reason: ContactReason;
  index?: number;
  class?: string;
}

const { reason, index = 0, class: className } = Astro.props;
---

<div class={`py-4 border-b border-(--oc-outline-variant)/10 ${className || ''}`}>
  <h3 class="font-label text-xs uppercase tracking-widest text-(--oc-on-surface-variant) mb-2">
    {reason.title}
  </h3>
  <p class="font-body text-(--oc-on-surface-variant)/60 text-sm leading-relaxed mb-3">
    {reason.description}
  </p>
  {reason.examples && reason.examples.length > 0 && (
    <ul class="space-y-1">
      {reason.examples.map((example) => (
        <li class="font-body text-(--oc-on-surface-variant)/50 text-xs leading-relaxed">
          &mdash; {example}
        </li>
      ))}
    </ul>
  )}
</div>
