---
import { Icon } from 'astro-icon/components';
import type { ContactReason } from '../../types/contact';

interface Props {
  reason: ContactReason;
  index?: number;
  class?: string;
}

const { reason, index = 0, class: className } = Astro.props;
const displayNumber = String(index + 1).padStart(2, '0');
---

<div class={`reason-card group ${className || ''}`}>
  <div class="reason-number">{displayNumber}</div>
  <div class="relative p-6 lg:p-8">
    <div class="flex items-start gap-4">
      <div class="reason-icon-wrap shrink-0">
        <Icon name={reason.icon} class="w-6 h-6" />
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-xl font-semibold text-base-content mb-2 group-hover:text-primary transition-colors duration-300">
          {reason.title}
        </h3>
        <p class="text-base-content/65 text-sm leading-relaxed mb-5">{reason.description}</p>

        {reason.examples && reason.examples.length > 0 && (
          <div class="reason-examples">
            <p class="text-xs font-semibold text-base-content/40 uppercase tracking-[0.15em] mb-3">
              {reason.examplesTitle}
            </p>
            <ul class="space-y-2">
              {reason.examples.map((example) => (
                <li class="flex items-start gap-2.5 text-sm text-base-content/55">
                  <span class="reason-bullet mt-1.5 shrink-0"></span>
                  <span>{example}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .reason-card {
    position: relative;
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-premium);
    border-radius: 1.25rem;
    overflow: hidden;
    transition: transform 0.4s var(--ease-expo-out),
      box-shadow 0.4s var(--ease-expo-out);
  }

  .reason-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-premium-hover);
  }

  .reason-number {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-base-content);
    opacity: 0.04;
    font-family: var(--font-family-headers);
    pointer-events: none;
    user-select: none;
    transition: opacity 0.4s var(--ease-expo-out);
  }

  .reason-card:hover .reason-number {
    opacity: 0.08;
  }

  .reason-icon-wrap {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-rich), oklch(0.55 0.15 60));
    color: oklch(95% 0.01 83.24);
    box-shadow: 0 4px 12px oklch(0.48 0.18 35 / 0.2);
    transition: transform 0.3s var(--ease-expo-out);
  }

  .reason-card:hover .reason-icon-wrap {
    transform: scale(1.05);
  }

  .reason-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary-rich);
    opacity: 0.4;
    flex-shrink: 0;
  }

  .reason-examples {
    padding-top: 1rem;
    border-top: 1px solid oklch(0% 0 0 / 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .reason-card {
      transition: none;
    }
    .reason-card:hover {
      transform: none;
    }
    .reason-card:hover .reason-icon-wrap {
      transform: none;
    }
  }
</style>
