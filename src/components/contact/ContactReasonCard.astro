---
import { Icon } from 'astro-icon/components';
import type { ContactReason } from '../../types/contact';

interface Props {
  reason: ContactReason;
  class?: string;
}

const { reason, class: className } = Astro.props;
---

<div class={`card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${className || ''}`}>
  <div class="card-body p-6">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0">
        <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center">
          <Icon name={reason.icon} class="w-6 h-6 text-accent" />
        </div>
      </div>
      <div class="flex-1">
        <h3 class="text-xl font-medium text-base-content mb-2">{reason.title}</h3>
        <p class="text-base-content/70 text-sm mb-4 leading-relaxed">{reason.description}</p>
        
        {reason.examples && reason.examples.length > 0 && (
          <div class="space-y-2">
            <p class="text-xs font-medium text-base-content/50 uppercase tracking-wider">{reason.examplesTitle}</p>
            <ul class="space-y-1">
              {reason.examples.map((example) => (
                <li class="flex items-center gap-2 text-sm text-base-content/60">
                  <Icon name="mdi:circle-small" class="w-3 h-3 text-base-content/40 flex-shrink-0" />
                  <span>{example}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card:hover {
    transform: translateY(-4px);
  }
</style>