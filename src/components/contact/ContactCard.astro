---
import { Icon } from 'astro-icon/components';
import type { ContactMethod } from '../../types/contact';

interface Props {
  method: ContactMethod;
  class?: string;
}

const { method, class: className } = Astro.props;
---

<div class={`card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${className || ''}`}>
  <div class="card-body p-6">
    <div class="flex items-start gap-4">
      <div class="flex-shrink-0">
        <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
          <Icon name={method.icon} class="w-6 h-6 text-primary" />
        </div>
      </div>
      <div class="flex-1">
        <h3 class="text-xl font-medium text-base-content mb-2">{method.title}</h3>
        {method.description && (
          <p class="text-base-content/60 text-sm mb-3 leading-relaxed">{method.description}</p>
        )}
        <div class="text-base-content">
          {method.href ? (
            <a 
              href={method.href} 
              class="text-primary hover:text-primary/80 transition-colors duration-200 font-medium"
              target={method.type === 'social' ? '_blank' : undefined}
              rel={method.type === 'social' ? 'noopener noreferrer' : undefined}
            >
              {method.value}
            </a>
          ) : (
            <span class="font-medium">{method.value}</span>
          )}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .card:hover {
    transform: translateY(-4px);
  }
</style>