---
import type { ContactMethod } from '../../types/contact';

interface Props {
  method: ContactMethod;
  index?: number;
  class?: string;
}

const { method, index = 0, class: className } = Astro.props;
---

<section class={`border-l-2 border-(--oc-primary) pl-4 mb-6 ${className || ''}`}>
  <h3 class="font-label text-(--oc-primary) uppercase text-xs tracking-widest mb-6">
    {method.title}
  </h3>
  {method.description && (
    <p class="font-body text-(--oc-on-surface-variant) text-sm leading-relaxed mb-4">
      {method.description}
    </p>
  )}
  <div>
    {method.href ? (
      <a
        href={method.href}
        class="font-label text-(--oc-tertiary) uppercase text-[10px] tracking-widest hover:underline decoration-1 transition-all"
        target={method.type === 'social' ? '_blank' : undefined}
        rel={method.type === 'social' ? 'noopener noreferrer' : undefined}
      >
        {method.value} &rarr;
      </a>
    ) : (
      <span class="font-label text-(--oc-on-surface-variant) uppercase text-[10px] tracking-widest">
        {method.value}
      </span>
    )}
  </div>
</section>
