---
import { getLangFromUrl } from "../../../i18n/utils";
import type { Language } from "../../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const currentPath = Astro.url.pathname;

const otherLang: Language = lang === "en" ? "es" : "en";
const otherLangPath = currentPath.replace(new RegExp(`^/${lang}`), `/${otherLang}`);
const otherLangLabel = lang === "en" ? "Español" : "English";
---

<div class="language-switcher" role="navigation" aria-label="Language switcher">
  <a
    href={otherLangPath}
    class="px-2 py-1 bg-dark text-light hover:bg-secondary hover:text-dark rounded transition-colors duration-300"
    aria-label={`Switch to ${otherLangLabel}`}
    hreflang={otherLang}
    lang={otherLang}
  >
    {lang === "en" ? "ES" : "EN"}
  </a>
</div>
