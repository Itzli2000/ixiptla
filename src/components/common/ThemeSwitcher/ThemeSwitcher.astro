---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<label class={`swap swap-rotate ${className}`} id="theme-switcher" aria-label="Toggle dark mode">
  <input type="checkbox" class="theme-controller" value="ixpitla-dark" />

  <!-- sun icon -->
  <svg
    class="swap-off h-6 w-6 fill-current"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
    ></path>
  </svg>

  <!-- moon icon -->
  <svg
    class="swap-on h-6 w-6 fill-current"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
    ></path>
  </svg>
</label>

<script is:inline>
  function initializeTheme() {
    const getSystemTheme = () => {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "ixpitla-dark"
        : "ixpitla";
    };

    const theme = (() => {
      if (
        typeof localStorage !== "undefined" &&
        localStorage.getItem("theme")
      ) {
        return localStorage.getItem("theme");
      }
      return getSystemTheme();
    })();

    // Apply theme immediately
    if (theme === "ixpitla-dark") {
      document.documentElement.setAttribute("data-theme", "ixpitla-dark");
      const controller = document.querySelector(".theme-controller");
      if (controller) controller.setAttribute("checked", "");
    } else {
      document.documentElement.setAttribute("data-theme", "ixpitla");
      const controller = document.querySelector(".theme-controller");
      if (controller) controller.removeAttribute("checked");
    }
  }

  function setupThemeListeners() {
    const themeToggle = document.querySelector(".theme-controller");

    // Remove existing listeners to prevent duplicates
    const newToggle = themeToggle?.cloneNode(true);
    if (themeToggle && newToggle) {
      themeToggle.parentNode?.replaceChild(newToggle, themeToggle);
    }

    const currentToggle = document.querySelector(".theme-controller");
    currentToggle?.addEventListener("change", (e) => {
      const target = e.target;
      if (target instanceof HTMLInputElement && target.checked) {
        document.documentElement.setAttribute("data-theme", "ixpitla-dark");
        localStorage.setItem("theme", "ixpitla-dark");
      } else {
        document.documentElement.setAttribute("data-theme", "ixpitla");
        localStorage.setItem("theme", "ixpitla");
      }
    });

    // System theme change listener
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", (e) => {
        const newTheme = e.matches ? "ixpitla-dark" : "ixpitla";
        document.documentElement.setAttribute("data-theme", newTheme);
        currentToggle.click();
      });
  }

  // Initialize on page load
  initializeTheme();

  // Setup listeners when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeListeners);
  } else {
    setupThemeListeners();
  }

  // Re-initialize on view transitions (Astro specific)
  document.addEventListener("astro:page-load", () => {
    initializeTheme();
    setupThemeListeners();
  });

  // Also handle before swap to prevent FOUC
  document.addEventListener("astro:before-swap", () => {
    initializeTheme();
  });
</script>

