---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { Image } from "astro:assets";
import colibri from "public/images/colibri.png";
import type { Language } from "../../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
---

<div class="hero-section">
  <div id="logo-mask" class="fixed top-0 w-full h-screen">
    <section class="hero-background">
      <Image
        id="hero-image"
        src={colibri}
        alt={t("hero.imageAlt")}
        class="hero-image"
        width={600}
        height={600}
      />
    </section>
  </div>
</div>

<style>
  .hero-section {
    position: relative;
    height: 250vh;
  }

  #logo-mask {
    background: var(--color-base-200);
    mask-image: url("/logo-mask.svg");
    mask-repeat: no-repeat;
    mask-position: 25% center;
    mask-size: clamp(100000vh, 3500%, 0vh);
    -webkit-mask-image: url("/logo-mask.svg");
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: 25% center;
    -webkit-mask-size: clamp(100000vh, 3500%, 0vh);
    z-index: 10;
  }

  .hero-background {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .hero-image {
    object-fit: cover;
    scale: 1.25;
    will-change: transform;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Usar el evento astro:page-load para compatibilidad con View Transitions
  document.addEventListener("astro:page-load", () => {
    gsap.registerPlugin(ScrollTrigger);

    // Detectar el tamaño de pantalla para ajustar solo el tamaño final
    const isMobile = window.matchMedia("(max-width: 768px)").matches;
    const isTablet = window.matchMedia("(max-width: 1024px) and (min-width: 769px)").matches;
    const isTabletPortrait = window.matchMedia("(max-width: 1024px) and (min-width: 769px) and (orientation: portrait)").matches;
    const isSmallMobile = window.matchMedia("(max-width: 480px)").matches;

    // Solo cambiar el tamaño final del mask según el dispositivo
    let finalMaskSize = "clamp(100vh, 30%, 40vh)"; // Desktop default

    if (isSmallMobile) {
      finalMaskSize = "clamp(45vh, 15%, 25vh)";
    } else if (isMobile) {
      finalMaskSize = "clamp(50vh, 20%, 30vh)";
    } else if (isTabletPortrait) {
      finalMaskSize = "clamp(60vh, 22%, 32vh)";
    } else if (isTablet) {
      finalMaskSize = "clamp(70vh, 25%, 35vh)";
    }

    const tl = gsap.timeline({
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".hero-section",
        start: "top bottom",
        end: "bottom top",
        scrub: 1,
      },
    });

    tl.to("#hero-image", { 
      duration: 1, 
      scale: 1,
    })
    .to("#logo-mask", {
      maskSize: finalMaskSize,
      webkitMaskSize: finalMaskSize,
      duration: 0.75,
    }, "<")
    .to("#hero-image", {
      opacity: 0,
      duration: 0.1,
    }, 0.8)
    .to("#logo-mask", {
      opacity: 0,
      zIndex: -1,
      duration: 0.5,
    }, 0.9);
  });
</script>
