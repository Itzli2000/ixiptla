---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import BreadcrumbNavigation from "../ui/BreadcrumbNavigation.astro";
import type { Language } from "../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const breadcrumbItems = [
  {
    label: t("navigation.home"),
    href: `/${lang}`,
  },
  {
    label: t("navigation.collection"),
    href: `/${lang}/collection`,
    current: true,
  },
];
---

<header class="collection-header section-elevated relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 pt-24 pb-12 lg:pt-32 lg:pb-16">
    <!-- Breadcrumb Navigation -->
    <BreadcrumbNavigation
      items={breadcrumbItems}
      lang={lang}
      t={t}
      className="mb-6"
    />

    <!-- Page Header -->
    <div class="text-center max-w-4xl mx-auto" data-reveal>
      <h1 class="collection-title font-serif text-4xl md:text-5xl lg:text-6xl font-normal text-base-content mb-4">
        {t("collection.title")}
      </h1>

      <p class="collection-subtitle text-lg md:text-xl text-primary font-medium mb-6">
        {t("collection.subtitle")}
      </p>

      <p class="collection-description text-base md:text-lg text-base-content/80 leading-relaxed max-w-3xl mx-auto">
        {t("collection.description")}
      </p>
    </div>
  </div>

  <!-- Gradient bottom border -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>

  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 -right-32 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 -left-32 w-96 h-96 bg-secondary/5 rounded-full blur-3xl"></div>
  </div>
</header>

<style>
  .collection-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .collection-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
  }

  .collection-description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
  }
</style>
