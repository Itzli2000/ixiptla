---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, getCollectionName } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import CollectionHeader from "./CollectionHeader.astro";
import FilterToolbarAstro from "./FilterToolbarAstro.astro";
import SearchBoxAstro from "./SearchBoxAstro.astro";
import ResultsSummary from "./ResultsSummary.astro";
import EnhancedArtifactCard from "./EnhancedArtifactCard.astro";
import EmptyState from "./EmptyState.astro";
import LoadingSkeleton from "./LoadingSkeleton.astro";
import type { Language } from "../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Get artifacts from the appropriate collection
const artifacts = await getCollection(getCollectionName(lang));

// Sort artifacts alphabetically by title
const sortedArtifacts = artifacts.sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

// SEO metadata
const pageTitle = `${t("collection.title")} - ${t("collection.subtitle")}`;
const pageDescription = t("collection.description");

const imageURL = `/images/og-image-${lang}.png`;
const canonicalURL = Astro.site ? new URL(`/${lang}/collection`, Astro.site) : undefined;
const alternateURLs = Astro.site
  ? {
      en: new URL(`/en/collection`, Astro.site),
      es: new URL(`/es/collection`, Astro.site),
    }
  : undefined;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  image={imageURL}
  canonicalURL={canonicalURL}
  alternateURLs={alternateURLs}
>
  <!-- Collection Header -->
  <CollectionHeader />

  <!-- Main Collection Content -->
  <main class="collection-main">
    <div class="max-w-7xl mx-auto px-4 py-8 lg:py-12">

      <!-- Controls Section -->
      <section class="mb-8 lg:mb-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

          <!-- Search Box -->
          <div class="search-container">
            <SearchBoxAstro
              placeholder={t("collection.search.placeholder")}
              className="w-full lg:w-96"
            />
          </div>
        </div>
      </section>

      <!-- Filter Toolbar -->
      <FilterToolbarAstro
        artifacts={sortedArtifacts.map((artifact) => artifact.data)}
        className="mb-8 lg:mb-12"
      />

      <!-- Results Summary -->
      <ResultsSummary
        totalCount={sortedArtifacts.length}
        filteredCount={sortedArtifacts.length}
        hasActiveFilters={false}
      />

      <!-- Loading Skeleton (hidden by default) -->
      <LoadingSkeleton
        count={6}
        variant="grid"
        className="loading-skeleton hidden"
      />

      <!-- Collection Grid -->
      <section
        class="collection-grid"
        aria-label={t("collection.title")}
        data-collection-grid
      >
        <div
          class="artifacts-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-1"
          data-view-mode="grid"
        >
          {sortedArtifacts.map((artifact, index) => (
            <div
              class="artifact-item"
              data-culture={artifact.data.culture.toLowerCase()}
              data-period={artifact.data.period.toLowerCase()}
              data-material={artifact.data.material?.toLowerCase() || ''}
              data-has-3d={Boolean(artifact.data.has3DModel || false)}
              data-search-text={`${artifact.data.title} ${artifact.data.description} ${artifact.data.culture} ${artifact.data.period} ${artifact.data.material || ''} ${artifact.data.museum}`.toLowerCase()}
            >
              <EnhancedArtifactCard
                artifact={artifact.data}
                index={index}
              />
            </div>
          ))}
        </div>

        <!-- Empty State (hidden by default) -->
        <EmptyState
          type="no-results"
          className="empty-state !hidden"
        />
      </section>
    </div>
  </main>
</Layout>

<style>
  .collection-main {
    min-height: 60vh;
  }

  .artifacts-grid {
    min-height: 400px;
  }

  .artifact-item {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .artifact-item.hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    height: 0;
    overflow: hidden;
    margin: 0;
  }

  .loading-skeleton.visible {
    display: block;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .artifacts-grid,
    .artifact-item {
      transition: none;
    }
  }
</style>

<script>
  interface FilterState {
    culture: string;
    period: string;
    material: string;
    has3D: boolean | null;
    searchQuery: string;
  }

  class CollectionManager {
    private grid: HTMLElement | null;
    private emptyState: HTMLElement | null;
    private artifactItems: NodeListOf<HTMLElement>;

    private filters: FilterState = {
      culture: 'all',
      period: 'all',
      material: 'all',
      has3D: null,
      searchQuery: ''
    };

    constructor() {
      this.grid = document.querySelector('[data-collection-grid] .artifacts-grid');
      this.emptyState = document.querySelector('.empty-state');
      this.artifactItems = document.querySelectorAll('.artifact-item');

      this.init();
    }

    init() {
      // Listen for filter and search events
      document.addEventListener('filtersChanged', this.handleFiltersChanged.bind(this));
      document.addEventListener('collectionSearch', this.handleSearch.bind(this));
      document.addEventListener('clearAllFilters', this.clearAllFilters.bind(this));

      // Initial render
      this.applyFiltersAndSearch();
    }

    private handleFiltersChanged(event: CustomEvent) {
      const { filters } = event.detail;
      this.filters = { ...this.filters, ...filters };
      this.applyFiltersAndSearch();
    }

    private handleSearch(event: CustomEvent) {
      const { query } = event.detail;
      this.filters.searchQuery = query;
      this.applyFiltersAndSearch();
    }

    private clearAllFilters() {
      this.filters = {
        culture: 'all',
        period: 'all',
        material: 'all',
        has3D: null,
        searchQuery: ''
      };
      this.applyFiltersAndSearch();
    }

    private applyFiltersAndSearch() {
      let visibleCount = 0;
      const searchQuery = this.filters.searchQuery.toLowerCase().trim();

      this.artifactItems.forEach(item => {
        let visible = true;

        // Culture filter
        if (this.filters.culture !== 'all') {
          const itemCulture = item.getAttribute('data-culture');
          visible = visible && itemCulture === this.filters.culture;
        }

        // Period filter
        if (this.filters.period !== 'all') {
          const itemPeriod = item.getAttribute('data-period');
          visible = visible && itemPeriod?.includes(this.filters.period) || false;
        }

        // Material filter
        if (this.filters.material !== 'all') {
          const itemMaterial = item.getAttribute('data-material');
          visible = visible && itemMaterial?.includes(this.filters.material) || false;
        }

        // 3D filter
        if (this.filters.has3D !== null) {
          const itemHas3D = item.getAttribute('data-has-3d') === 'true';
          visible = visible && (itemHas3D === Boolean(this.filters.has3D));
        }

        // Search filter
        if (searchQuery) {
          const searchText = item.getAttribute('data-search-text') || '';
          visible = visible && searchText.includes(searchQuery);
        }

        // Apply visibility
        if (visible) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Update results count
      this.updateResultsDisplay(visibleCount);

      // Show/hide empty state
      this.toggleEmptyState(visibleCount === 0);
    }

    private updateResultsDisplay(count: number) {
      // Dispatch event for results summary
      document.dispatchEvent(new CustomEvent('resultsUpdated', {
        detail: {
          filteredCount: count,
          totalCount: this.artifactItems.length,
          hasActiveFilters: this.hasActiveFilters()
        }
      }));
    }

    private toggleEmptyState(show: boolean) {
      if (this.emptyState && this.grid) {
        if (show) {
          this.emptyState.classList.remove('!hidden');
          this.emptyState.classList.add('visible');
          this.grid.style.display = 'none';
        } else {
          this.emptyState.classList.add('!hidden');
          this.emptyState.classList.remove('visible');
          this.grid.style.display = 'grid';
        }
      }
    }

    private hasActiveFilters(): boolean {
      return this.filters.culture !== 'all' ||
             this.filters.period !== 'all' ||
             this.filters.material !== 'all' ||
             this.filters.has3D !== null ||
             this.filters.searchQuery.trim() !== '';
    }
  }

  let collectionManagerInstance: CollectionManager | null = null;

  document.addEventListener('astro:page-load', () => {
    collectionManagerInstance = new CollectionManager();
  });
</script>
