---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Language } from "../../types";

interface Props {
  type?: "no-results" | "no-artifacts" | "loading-error";
  searchQuery?: string;
  hasFilters?: boolean;
  className?: string;
}

const { 
  type = "no-results", 
  searchQuery = "", 
  hasFilters = false,
  className = "" 
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Determine content based on type
const getContent = () => {
  switch (type) {
    case "no-results":
      return {
        icon: "mdi:magnify",
        title: t("collection.empty.title"),
        description: hasFilters 
          ? t("collection.empty.description")
          : t("collection.empty.noFilters"),
        action: hasFilters ? t("collection.empty.action") : t("collection.empty.exploreAll"),
        actionEvent: hasFilters ? "clearAllFilters" : "showAllArtifacts"
      };
    case "no-artifacts":
      return {
        icon: "mdi:database-off",
        title: t("collection.errors.noArtifacts.title"),
        description: t("collection.errors.noArtifacts.description"),
        action: t("collection.errors.retry"),
        actionEvent: "retryLoad"
      };
    case "loading-error":
      return {
        icon: "mdi:alert-circle",
        title: t("collection.errors.loadingError.title"),
        description: t("collection.errors.loadingError.description"),
        action: t("collection.errors.retry"),
        actionEvent: "retryLoad"
      };
    default:
      return {
        icon: "mdi:help-circle",
        title: t("collection.errors.unknown.title"),
        description: t("collection.errors.unknown.description"),
        action: t("collection.errors.goHome"),
        actionEvent: "goHome"
      };
  }
};

const content = getContent();
---

<div class={`empty-state ${className}`} role="status" aria-live="polite">
  <div class="empty-state-container">
    <!-- Icon -->
    <div class="empty-state-icon">
      <Icon 
        name={content.icon} 
        class="w-16 h-16 text-base-content/40 mx-auto"
        aria-hidden="true"
      />
    </div>
    
    <!-- Content -->
    <div class="empty-state-content">
      <h3 class="empty-state-title">
        {content.title}
      </h3>
      
      <p class="empty-state-description">
        {content.description}
        {searchQuery && (
          <span class="search-query">
            "{searchQuery}"
          </span>
        )}
      </p>
      
      <!-- Suggestions for search -->
      {type === "no-results" && searchQuery && (
        <div class="search-suggestions">
          <p class="suggestions-title">{t("collection.empty.suggestions.title")}</p>
          <ul class="suggestions-list">
            <li>{t("collection.empty.suggestions.checkSpelling")}</li>
            <li>{t("collection.empty.suggestions.useGeneral")}</li>
            <li>{t("collection.empty.suggestions.searchCulture")}</li>
            <li>{t("collection.empty.suggestions.searchMaterial")}</li>
          </ul>
        </div>
      )}
    </div>
    
    <!-- Action Button -->
    <div class="empty-state-actions">
      <button 
        class="btn btn-outline btn-primary action-button"
        onclick={`window.dispatchEvent(new CustomEvent('${content.actionEvent}'))`}
        aria-label={content.action}
      >
        {content.action}
      </button>
      
      <!-- Secondary action for no-results -->
      {type === "no-results" && (
        <a 
          href={lang === "es" ? "/" : "/en"}
          class="btn btn-ghost btn-sm mt-2"
        >
          {t("collection.errors.goHome")}
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    padding: 2rem;
    background: linear-gradient(
      135deg,
      hsl(var(--b2) / 0.3) 0%,
      hsl(var(--b1) / 0.5) 100%
    );
    border: 2px dashed hsl(var(--bc) / 0.2);
    border-radius: 1rem;
    margin: 2rem 0;
    animation: fadeIn 0.5s ease-out;
  }
  
  .empty-state-container {
    text-align: center;
    max-width: 28rem;
    width: 100%;
  }
  
  .empty-state-icon {
    margin-bottom: 1.5rem;
    animation: float 3s ease-in-out infinite;
  }
  
  .empty-state-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  
  .empty-state-description {
    font-size: 1rem;
    color: hsl(var(--bc) / 0.7);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  .search-query {
    display: inline-block;
    background: hsl(var(--p) / 0.1);
    color: hsl(var(--p));
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
    font-weight: 500;
    margin-left: 0.25rem;
  }
  
  .search-suggestions {
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--b3));
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
    text-align: left;
  }
  
  .suggestions-title {
    font-weight: 600;
    color: hsl(var(--bc));
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }
  
  .suggestions-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .suggestions-list li {
    font-size: 0.875rem;
    color: hsl(var(--bc) / 0.8);
    margin-bottom: 0.5rem;
    padding-left: 1rem;
    position: relative;
  }
  
  .suggestions-list li::before {
    content: "•";
    color: hsl(var(--p));
    position: absolute;
    left: 0;
    font-weight: bold;
  }
  
  .empty-state-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  
  .action-button {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 8rem;
  }
  
  .action-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px hsl(var(--p) / 0.2);
  }
  
  .action-button:active {
    transform: translateY(0);
  }
  
  /* Animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  
  /* Responsive design */
  @media (max-width: 640px) {
    .empty-state {
      min-height: 300px;
      padding: 1.5rem;
      margin: 1rem 0;
    }
    
    .empty-state-icon {
      margin-bottom: 1rem;
    }
    
    .empty-state-icon svg {
      width: 3rem;
      height: 3rem;
    }
    
    .empty-state-title {
      font-size: 1.25rem;
    }
    
    .empty-state-description {
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }
    
    .search-suggestions {
      padding: 1rem;
      margin: 1rem 0;
    }
  }
  
  /* High contrast mode */
  @media (prefers-contrast: high) {
    .empty-state {
      border-width: 3px;
      background: hsl(var(--b1));
    }
    
    .search-query {
      border: 1px solid hsl(var(--p));
    }
    
    .search-suggestions {
      border-width: 2px;
    }
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .empty-state {
      animation: none;
    }
    
    .empty-state-icon {
      animation: none;
    }
    
    .action-button:hover {
      transform: none;
    }
  }
  
  /* Dark mode optimizations */
  @media (prefers-color-scheme: dark) {
    .empty-state {
      background: linear-gradient(
        135deg,
        hsl(var(--b3) / 0.2) 0%,
        hsl(var(--b2) / 0.3) 100%
      );
    }
  }
  
  /* Print styles */
  @media print {
    .empty-state {
      border: 2px solid #000;
      background: none;
      page-break-inside: avoid;
    }
    
    .action-button {
      display: none;
    }
  }
</style>