---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getImageByFilename } from "../../utils/imageMapping";
import type { Language } from "../../types";
import type { ArtifactData } from "../../types/collection";

interface Props {
  artifact: ArtifactData;
  index?: number;
}

const { artifact, index = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const image = getImageByFilename(artifact.image);

// Generate descriptive alt text
const altText = `${artifact.title} - ${artifact.culture} ${artifact.period ? `del ${artifact.period}` : ''} ${artifact.material ? `en ${artifact.material}` : ''}`.trim();

// Determine card link
const cardLink = `/${lang}/collection/${artifact.slug}`;

// Check if artifact has 3D model
const has3D = Boolean(artifact.has3DModel);

// Generate a reference code from culture and slug
const refCode = `${artifact.culture.substring(0, 3).toUpperCase()}-${String(index + 1).padStart(3, '0')}`;
---

<article
  class="artifact-card"
  data-culture={artifact.culture.toLowerCase()}
  data-has-3d={has3D}
  style={`animation-delay: ${index * 0.1}s`}
>
  <a
    href={cardLink}
    class="group relative bg-(--oc-surface-container-low) p-6 flex flex-col hover:bg-(--oc-surface-bright) transition-colors duration-300 h-full focus:outline-none focus:ring-1 focus:ring-(--oc-primary)"
    aria-label={`View details for ${artifact.title}`}
  >
    <!-- Image Section -->
    <div class="aspect-[3/4] mb-6 bg-(--oc-surface-container-lowest) overflow-hidden relative">
      <Image
        transition:name={`artifact-${artifact.slug}`}
        src={image}
        alt={altText}
        width={400}
        height={533}
        class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
        loading={index < 6 ? "eager" : "lazy"}
      />

      <!-- 3D Badge -->
      {has3D && (
        <div class="absolute top-3 right-3">
          <span class="inline-flex items-center px-2 py-1 text-[10px] font-label uppercase tracking-widest bg-(--oc-primary) text-(--oc-on-primary) font-bold">
            <Icon name="mdi:cube-outline" class="w-3 h-3 mr-1" />
            3D
          </span>
        </div>
      )}
    </div>

    <!-- Content Section -->
    <div class="mt-auto">
      <span class="block font-label text-[10px] text-(--oc-tertiary) mb-1">REF: {refCode}</span>
      <h3 class="font-headline text-xl font-bold text-(--oc-on-surface) mb-4">{artifact.title}</h3>

      <div class="grid grid-cols-2 gap-2 bg-(--oc-surface-container-lowest) p-3 border-b-2 border-transparent group-hover:border-(--oc-tertiary) transition-colors">
        <div>
          <p class="font-label text-[9px] text-stone-500 uppercase tracking-tighter leading-none">
            {t("collection.filters.period")}
          </p>
          <p class="font-label text-[10px] text-(--oc-on-surface-variant) font-bold leading-none mt-1">
            {artifact.period}
          </p>
        </div>
        <div>
          <p class="font-label text-[9px] text-stone-500 uppercase tracking-tighter leading-none">
            {t("collection.filters.material")}
          </p>
          <p class="font-label text-[10px] text-(--oc-on-surface-variant) font-bold leading-none mt-1">
            {artifact.material || "—"}
          </p>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .artifact-card {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Focus styles */
  .artifact-card a:focus {
    outline: 1px solid var(--oc-primary);
    outline-offset: -1px;
  }

  /* Loading states */
  .artifact-card[data-loading="true"] {
    opacity: 0.6;
    pointer-events: none;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .artifact-card a {
      border: 1px solid currentColor;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .artifact-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
