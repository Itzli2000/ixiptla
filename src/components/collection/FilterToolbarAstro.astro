---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import type { Language } from "../../types";
import type { ArtifactData } from "../../types/collection";

interface Props {
  artifacts: ArtifactData[];
  className?: string;
}

const { artifacts, className = "" } = Astro.props;

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

// Extract filter options from artifacts
const cultures = [...new Set(artifacts.map(artifact => artifact.culture))].sort();
const periods = [...new Set(artifacts.map(artifact => artifact.period))].sort();
const materials = [...new Set(artifacts
  .map(artifact => artifact.material)
  .filter(Boolean)
)].sort();
---

<div class={`filter-toolbar ${className}`} data-filter-toolbar>
  <!-- Mobile Filter Toggle -->
  <div class="mobile-filter-header lg:hidden">
    <button
      class="flex items-center justify-between w-full p-4 font-label text-xs uppercase tracking-widest text-(--oc-on-surface) bg-transparent border-none cursor-pointer"
      data-filter-toggle
      aria-expanded="false"
      aria-controls="filter-content"
    >
      <span class="flex items-center gap-2">
        <Icon name="mdi:filter-variant" class="w-5 h-5" />
        {t("collection.filters.title")}
        <span class="filter-count-badge hidden px-2 py-0.5 text-[10px] font-bold bg-(--oc-primary) text-(--oc-on-primary)" data-filter-count>0</span>
      </span>
      <Icon
        name="mdi:chevron-down"
        class="w-4 h-4 transition-transform chevron-icon"
      />
    </button>
  </div>

  <!-- Filter Content -->
  <div
    id="filter-content"
    class="filter-content"
    data-filter-content
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Culture Filter -->
      <div class="space-y-4">
        <label class="font-label text-xs uppercase tracking-widest text-stone-500" for="culture-select">
          {t("collection.filters.culture")}
        </label>
        <select
          id="culture-select"
          class="w-full px-4 py-2 bg-(--oc-surface-container-high) text-(--oc-on-surface) font-label text-xs uppercase tracking-widest border-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-(--oc-primary)"
          data-filter="culture"
          aria-label={`Filter by ${t("collection.filters.culture")}`}
        >
          <option value="all">{t("collection.cultures.all")}</option>
          {cultures.map((culture) => (
            <option value={culture.toLowerCase()}>
              {culture}
            </option>
          ))}
        </select>
      </div>

      <!-- Period Filter -->
      <div class="space-y-4">
        <label class="font-label text-xs uppercase tracking-widest text-stone-500" for="period-select">
          {t("collection.filters.period")}
        </label>
        <select
          id="period-select"
          class="w-full px-4 py-2 bg-(--oc-surface-container-high) text-(--oc-on-surface) font-label text-xs uppercase tracking-widest border-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-(--oc-primary)"
          data-filter="period"
          aria-label={`Filter by ${t("collection.filters.period")}`}
        >
          <option value="all">{t("collection.cultures.all")}</option>
          {periods.map((period) => (
            <option value={period.toLowerCase()}>
              {period}
            </option>
          ))}
        </select>
      </div>

      <!-- Material Filter -->
      <div class="space-y-4">
        <label class="font-label text-xs uppercase tracking-widest text-stone-500" for="material-select">
          {t("collection.filters.material")}
        </label>
        <select
          id="material-select"
          class="w-full px-4 py-2 bg-(--oc-surface-container-high) text-(--oc-on-surface) font-label text-xs uppercase tracking-widest border-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-(--oc-primary)"
          data-filter="material"
          aria-label={`Filter by ${t("collection.filters.material")}`}
        >
          <option value="all">{t("collection.cultures.all")}</option>
          {materials.map((material) => (
            <option value={material?.toLowerCase() || ''}>
              {material}
            </option>
          ))}
        </select>
      </div>

      <!-- 3D Model Filter -->
      <div class="space-y-4">
        <label class="font-label text-xs uppercase tracking-widest text-stone-500">
          {t("collection.filters.has3D")}
        </label>
        <button
          class="filter-3d-toggle flex items-center gap-2 w-full px-4 py-2 bg-(--oc-surface-container-high) text-stone-400 font-label text-xs uppercase tracking-widest border-none cursor-pointer hover:text-(--oc-on-surface) transition-colors"
          data-filter="has3D"
          data-toggle-3d
          data-text-all={t("collection.filters.all")}
          data-text-only={t("collection.filters.only3D")}
          aria-pressed="false"
          aria-label={`Toggle ${t("collection.filters.has3D")} filter`}
        >
          <span class="flex items-center justify-center w-4 h-4">
            <Icon name="mdi:cube-outline" class="w-4 h-4" />
          </span>
          <span data-toggle-text>
            {t("collection.filters.all")}
          </span>
        </button>
      </div>
    </div>

    <!-- Filter Actions -->
    <div class="filter-actions hidden flex justify-end pt-6" data-filter-actions>
      <button
        class="flex items-center px-4 py-2 bg-(--oc-surface-container-high) text-stone-400 font-label text-xs uppercase tracking-widest border-none cursor-pointer hover:text-(--oc-on-surface) transition-colors"
        data-clear-filters
        aria-label={t("collection.filters.clear")}
      >
        <Icon name="mdi:close" class="w-4 h-4 mr-2" />
        {t("collection.filters.clear")}
      </button>
    </div>
  </div>
</div>

<style>
  .filter-toolbar {
    background: var(--oc-surface-container-lowest);
    padding: 0;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .filter-content {
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  @media (max-width: 1023px) {
    .filter-content {
      max-height: 0;
      overflow: hidden;
      padding: 0 1.5rem;
      opacity: 0;
    }

    .filter-content.expanded {
      max-height: 500px;
      padding: 1.5rem;
      opacity: 1;
    }
  }

  @media (min-width: 1024px) {
    .mobile-filter-header {
      display: none;
    }

    .filter-content {
      max-height: none;
      overflow: visible;
      opacity: 1;
    }
  }

  .chevron-icon.rotated {
    transform: rotate(180deg);
  }

  .filter-count-badge.hidden {
    display: none;
  }

  .filter-actions.hidden {
    display: none;
  }

  .filter-3d-toggle[aria-pressed="true"] {
    background: var(--oc-primary);
    color: var(--oc-on-primary);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .filter-content,
    .chevron-icon {
      transition: none;
    }
  }
</style>

<script>
  interface FilterState {
    culture: string;
    period: string;
    material: string;
    has3D: boolean | null;
  }

  class CollectionFilters {
    private toolbar: HTMLElement | null;
    private toggleBtn: HTMLElement | null;
    private content: HTMLElement | null;
    private chevronIcon: HTMLElement | null;
    private filterCount: HTMLElement | null;
    private filterActions: HTMLElement | null;
    private clearBtn: HTMLElement | null;
    private toggle3DBtn: HTMLElement | null;
    private toggleText: HTMLElement | null;

    private filters: FilterState = {
      culture: 'all',
      period: 'all',
      material: 'all',
      has3D: null
    };

    private isExpanded = false;

    constructor() {
      this.toolbar = document.querySelector('[data-filter-toolbar]');
      this.toggleBtn = document.querySelector('[data-filter-toggle]');
      this.content = document.querySelector('[data-filter-content]');
      this.chevronIcon = this.toggleBtn?.querySelector('.chevron-icon') || null;
      this.filterCount = document.querySelector('[data-filter-count]');
      this.filterActions = document.querySelector('[data-filter-actions]');
      this.clearBtn = document.querySelector('[data-clear-filters]');
      this.toggle3DBtn = document.querySelector('[data-toggle-3d]');
      this.toggleText = document.querySelector('[data-toggle-text]');

      this.init();
    }

    init() {
      if (!this.toolbar) return;

      // Setup event listeners
      this.toggleBtn?.addEventListener('click', this.toggleFilters.bind(this));
      this.clearBtn?.addEventListener('click', this.clearAllFilters.bind(this));
      this.toggle3DBtn?.addEventListener('click', this.toggle3D.bind(this));

      // Setup filter change listeners
      const filterSelects = this.toolbar.querySelectorAll('[data-filter]');
      filterSelects.forEach(select => {
        select.addEventListener('change', this.handleFilterChange.bind(this));
      });

      // Listen for external events
      document.addEventListener('clearAllFilters', this.clearAllFilters.bind(this));

      // Initial update
      this.updateFilterCount();
    }

    private toggleFilters() {
      this.isExpanded = !this.isExpanded;

      if (this.content && this.toggleBtn && this.chevronIcon) {
        if (this.isExpanded) {
          this.content.classList.add('expanded');
          this.chevronIcon.classList.add('rotated');
          this.toggleBtn.setAttribute('aria-expanded', 'true');
        } else {
          this.content.classList.remove('expanded');
          this.chevronIcon.classList.remove('rotated');
          this.toggleBtn.setAttribute('aria-expanded', 'false');
        }
      }
    }

    private handleFilterChange(event: Event) {
      const target = event.target as HTMLSelectElement;
      const filterType = target.getAttribute('data-filter') as keyof FilterState;

      if (filterType && filterType !== 'has3D') {
        this.filters[filterType] = target.value;
        this.updateFilterCount();
        this.applyFilters();
      }
    }

    private toggle3D() {
      this.filters.has3D = this.filters.has3D === true ? null : true;

      if (this.toggle3DBtn && this.toggleText) {
        const textAll = this.toggle3DBtn.getAttribute('data-text-all') || 'All';
        const textOnly = this.toggle3DBtn.getAttribute('data-text-only') || '3D Only';

        if (this.filters.has3D === true) {
          this.toggle3DBtn.setAttribute('aria-pressed', 'true');
          this.toggleText.textContent = textOnly;
        } else {
          this.toggle3DBtn.setAttribute('aria-pressed', 'false');
          this.toggleText.textContent = textAll;
        }
      }

      this.updateFilterCount();
      this.applyFilters();
    }

    private clearAllFilters() {
      this.filters = {
        culture: 'all',
        period: 'all',
        material: 'all',
        has3D: null
      };

      // Reset form elements
      const selects = this.toolbar?.querySelectorAll('select') || [];
      selects.forEach((select: Element) => {
        (select as HTMLSelectElement).value = 'all';
      });

      // Reset 3D toggle
      if (this.toggle3DBtn && this.toggleText) {
        const textAll = this.toggle3DBtn.getAttribute('data-text-all') || 'All';
        this.toggle3DBtn.setAttribute('aria-pressed', 'false');
        this.toggleText.textContent = textAll;
      }

      this.updateFilterCount();
      this.applyFilters();
    }

    private updateFilterCount() {
      let count = 0;
      if (this.filters.culture !== 'all') count++;
      if (this.filters.period !== 'all') count++;
      if (this.filters.material !== 'all') count++;
      if (this.filters.has3D !== null) count++;

      if (this.filterCount) {
        if (count > 0) {
          this.filterCount.textContent = count.toString();
          this.filterCount.classList.remove('hidden');
        } else {
          this.filterCount.classList.add('hidden');
        }
      }

      if (this.filterActions) {
        if (count > 0) {
          this.filterActions.classList.remove('hidden');
        } else {
          this.filterActions.classList.add('hidden');
        }
      }
    }

    private applyFilters() {
      // Dispatch filter change event
      document.dispatchEvent(new CustomEvent('filtersChanged', {
        detail: {
          filters: this.filters,
          hasActiveFilters: this.hasActiveFilters()
        }
      }));
    }

    private hasActiveFilters(): boolean {
      return this.filters.culture !== 'all' ||
             this.filters.period !== 'all' ||
             this.filters.material !== 'all' ||
             this.filters.has3D !== null;
    }
  }

  // Initialize when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new CollectionFilters();
  });

  // Re-initialize on Astro page navigation
  document.addEventListener('astro:page-load', () => {
    new CollectionFilters();
  });
</script>
