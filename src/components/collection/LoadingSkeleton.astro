---
interface Props {
  count?: number;
  variant?: "grid" | "list";
  className?: string;
}

const { count = 6, variant = "grid", className = "" } = Astro.props;

// Generate array for skeleton items
const skeletonItems = Array.from({ length: count }, (_, i) => i);
---

<div class={`loading-skeleton ${className}`} aria-label="Cargando colección...">
  <div class={`skeleton-grid ${
    variant === "grid" 
      ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" 
      : "grid grid-cols-1 gap-4"
  }`}>
    {skeletonItems.map((index) => (
      <div 
        class={`skeleton-card ${variant}-variant`}
        style={`animation-delay: ${index * 0.1}s`}
        aria-hidden="true"
      >
        {variant === "grid" ? (
          <!-- Grid Skeleton -->
          <div class="skeleton-grid-card">
            <div class="skeleton-image aspect-square"></div>
            <div class="skeleton-content">
              <div class="skeleton-title"></div>
              <div class="skeleton-text-line"></div>
              <div class="skeleton-text-line short"></div>
            </div>
          </div>
        ) : (
          <!-- List Skeleton -->
          <div class="skeleton-list-card">
            <div class="skeleton-image-list"></div>
            <div class="skeleton-content-list">
              <div class="skeleton-title"></div>
              <div class="skeleton-text-line"></div>
              <div class="skeleton-text-line short"></div>
              <div class="skeleton-metadata">
                <div class="skeleton-tag"></div>
                <div class="skeleton-tag"></div>
                <div class="skeleton-tag"></div>
              </div>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .loading-skeleton {
    padding: 1rem 0;
  }
  
  .skeleton-card {
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }
  
  /* Grid variant skeleton */
  .skeleton-grid-card {
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--b3) / 0.3);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 6px hsl(var(--shadow) / 0.1);
  }
  
  .skeleton-image {
    background: hsl(var(--b3));
    border-radius: 1rem 1rem 0 0;
    animation: shimmer 1.5s infinite ease-in-out;
  }
  
  .skeleton-content {
    padding: 1.5rem;
    space-y: 0.75rem;
  }
  
  /* List variant skeleton */
  .skeleton-list-card {
    background: hsl(var(--b1));
    border: 1px solid hsl(var(--b3) / 0.3);
    border-radius: 0.75rem;
    padding: 1rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    min-height: 12rem;
  }
  
  .skeleton-image-list {
    width: 12rem;
    height: 10rem;
    background: hsl(var(--b3));
    border-radius: 0.5rem;
    flex-shrink: 0;
    animation: shimmer 1.5s infinite ease-in-out;
  }
  
  .skeleton-content-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  /* Common skeleton elements */
  .skeleton-title {
    height: 1.5rem;
    background: hsl(var(--b3));
    border-radius: 0.375rem;
    width: 75%;
    animation: shimmer 1.5s infinite ease-in-out;
  }
  
  .skeleton-text-line {
    height: 1rem;
    background: hsl(var(--b3));
    border-radius: 0.25rem;
    width: 100%;
    animation: shimmer 1.5s infinite ease-in-out;
    margin-bottom: 0.5rem;
  }
  
  .skeleton-text-line.short {
    width: 60%;
  }
  
  .skeleton-metadata {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
  }
  
  .skeleton-tag {
    height: 1.5rem;
    width: 4rem;
    background: hsl(var(--b3));
    border-radius: 1rem;
    animation: shimmer 1.5s infinite ease-in-out;
  }
  
  /* Shimmer animation */
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }
  
  .skeleton-image,
  .skeleton-image-list,
  .skeleton-title,
  .skeleton-text-line,
  .skeleton-tag {
    background: linear-gradient(
      90deg,
      hsl(var(--b3)) 0%,
      hsl(var(--b2)) 50%,
      hsl(var(--b3)) 100%
    );
    background-size: 200% 100%;
  }
  
  /* Fade in animation */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .skeleton-list-card {
      flex-direction: column;
    }
    
    .skeleton-image-list {
      width: 100%;
      height: 8rem;
    }
    
    .skeleton-content {
      padding: 1rem;
    }
    
    .skeleton-content-list {
      gap: 0.5rem;
    }
    
    .skeleton-metadata {
      margin-top: 1rem;
    }
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .skeleton-card {
      animation: none;
      opacity: 1;
    }
    
    .skeleton-image,
    .skeleton-image-list,
    .skeleton-title,
    .skeleton-text-line,
    .skeleton-tag {
      animation: none;
      background: hsl(var(--b3));
    }
  }
  
  /* High contrast mode */
  @media (prefers-contrast: high) {
    .skeleton-grid-card,
    .skeleton-list-card {
      border-width: 2px;
    }
    
    .skeleton-image,
    .skeleton-image-list,
    .skeleton-title,
    .skeleton-text-line,
    .skeleton-tag {
      background: hsl(var(--bc) / 0.2);
    }
  }
  
  /* Dark mode optimizations */
  @media (prefers-color-scheme: dark) {
    .skeleton-image,
    .skeleton-image-list,
    .skeleton-title,
    .skeleton-text-line,
    .skeleton-tag {
      background: linear-gradient(
        90deg,
        hsl(var(--b3) / 0.8) 0%,
        hsl(var(--b2) / 0.6) 50%,
        hsl(var(--b3) / 0.8) 100%
      );
    }
  }
  
  /* Focus management for accessibility */
  .loading-skeleton:focus {
    outline: 2px solid hsl(var(--p));
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  
  /* Print styles */
  @media print {
    .loading-skeleton {
      display: none;
    }
  }
  
  /* Performance optimizations */
  .skeleton-card {
    will-change: opacity, transform;
  }
  
  .skeleton-image,
  .skeleton-image-list,
  .skeleton-title,
  .skeleton-text-line,
  .skeleton-tag {
    will-change: background-position;
  }
</style>