---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import type { Language } from '../../../types';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

const routes = {
  home: `/${lang}`,
  collection: `/${lang}/collection`,
  contact: `/${lang}/contact`,
};

const cultures = [
  { name: 'Maya', link: `/${lang}/collection?culture=maya` },
  { name: 'Mexica', link: `/${lang}/collection?culture=mexica` },
  { name: 'Acolhua', link: `/${lang}/collection?culture=acolhua` },
  { name: 'Mixteca', link: `/${lang}/collection?culture=mixteca` },
  { name: 'Teotihuacan', link: `/${lang}/collection?culture=teotihuacana` },
];
---

<footer class="px-4 sm:px-8 lg:px-24 py-12 bg-(--oc-surface-container-lowest) border-t border-(--oc-outline-variant)/15">
  <div class="flex flex-col md:flex-row justify-between items-start gap-8">
    <!-- Left side: Brand + Copyright -->
    <div>
      <span class="font-label font-bold text-(--oc-primary) tracking-tighter">{t('common.brandFull')}</span>
      <p class="font-label text-[10px] text-stone-500 uppercase tracking-widest mt-2">
        &copy; {currentYear} {t('common.copyright')}
      </p>
    </div>

    <!-- Right side: Nav + Culture links -->
    <div class="flex gap-8 font-label text-[10px] text-stone-500 uppercase tracking-widest">
      <div class="flex flex-col gap-2">
        <a href={routes.home} class="hover:text-(--oc-primary) transition-colors duration-300">
          {t('navigation.home')}
        </a>
        <a href={routes.collection} class="hover:text-(--oc-primary) transition-colors duration-300">
          {t('navigation.collection')}
        </a>
        <a href={routes.contact} class="hover:text-(--oc-primary) transition-colors duration-300">
          {t('navigation.contact')}
        </a>
      </div>
      <div class="flex flex-col gap-2">
        {cultures.map((culture) => (
          <a href={culture.link} class="hover:text-(--oc-primary) transition-colors duration-300">
            {culture.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Back to top -->
  <div class="mt-8 flex justify-end">
    <button
      class="footer-back-to-top font-label text-[10px] text-stone-500 uppercase tracking-widest hover:text-(--oc-primary) transition-colors duration-300 flex items-center gap-1"
      aria-label={t('footer.backToTop')}
    >
      <Icon name="mdi:arrow-up" class="w-3 h-3" />
      {t('footer.backToTop')}
    </button>
  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    const backToTop = document.querySelector('.footer-back-to-top');
    if (backToTop) {
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
