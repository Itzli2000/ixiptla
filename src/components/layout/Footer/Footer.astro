---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import type { Language } from '../../../types';

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

const routes = {
  home: `/${lang}`,
  collection: `/${lang}/collection`,
  contact: `/${lang}/contact`,
};

const cultures = [
  { name: 'Maya', link: `/${lang}/collection?culture=maya` },
  { name: 'Mexica', link: `/${lang}/collection?culture=mexica` },
  { name: 'Acolhua', link: `/${lang}/collection?culture=acolhua` },
  { name: 'Mixteca', link: `/${lang}/collection?culture=mixteca` },
  { name: 'Teotihuacan', link: `/${lang}/collection?culture=teotihuacana` },
];
---

<footer class="section-dark relative overflow-hidden">
  <!-- Gradient top border -->
  <div class="h-px w-full" style="background: linear-gradient(to right, transparent, var(--color-primary-rich), var(--color-gold-accent), var(--color-primary-rich), transparent);"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16">

      <!-- Column 1: Brand -->
      <div class="space-y-6">
        <a href={routes.home} class="inline-block" aria-label="Ixiptla Home">
          <Icon name="logo" class="w-auto h-10 opacity-90" />
        </a>
        <p class="text-sm opacity-60 leading-relaxed max-w-xs">
          {lang === 'es'
            ? 'Preservando el patrimonio arqueologico mesoamericano a traves de tecnologia digital y experiencias inmersivas.'
            : 'Preserving Mesoamerican archaeological heritage through digital technology and immersive experiences.'}
        </p>
      </div>

      <!-- Column 2: Navigation + Cultures -->
      <div class="grid grid-cols-2 gap-8">
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider opacity-40 mb-4">
            {t('navigation.home') === 'Inicio' ? 'Navegacion' : 'Navigation'}
          </h4>
          <ul class="space-y-3">
            <li>
              <a href={routes.home} class="text-sm opacity-60 hover:opacity-100 transition-opacity duration-300">
                {t('navigation.home')}
              </a>
            </li>
            <li>
              <a href={routes.collection} class="text-sm opacity-60 hover:opacity-100 transition-opacity duration-300">
                {t('navigation.collection')}
              </a>
            </li>
            <li>
              <a href={routes.contact} class="text-sm opacity-60 hover:opacity-100 transition-opacity duration-300">
                {t('navigation.contact')}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider opacity-40 mb-4">
            {lang === 'es' ? 'Culturas' : 'Cultures'}
          </h4>
          <ul class="space-y-3">
            {cultures.map((culture) => (
              <li>
                <a href={culture.link} class="text-sm opacity-60 hover:opacity-100 transition-opacity duration-300">
                  {culture.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Column 3: Tech credits -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider opacity-40 mb-4">
          {lang === 'es' ? 'Tecnologia' : 'Technology'}
        </h4>
        <p class="text-sm opacity-60 leading-relaxed mb-4">
          {lang === 'es'
            ? 'Construido con tecnologias modernas para ofrecer experiencias 3D interactivas y preservacion digital de alta fidelidad.'
            : 'Built with modern technologies for interactive 3D experiences and high-fidelity digital preservation.'}
        </p>
        <div class="flex flex-wrap gap-2">
          {['Astro', 'React', 'Three.js', 'TailwindCSS'].map((tech) => (
            <span class="text-xs px-2 py-1 rounded-full opacity-40" style="background: oklch(100% 0 0 / 0.06); border: 1px solid oklch(100% 0 0 / 0.08);">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4" style="border-top: 1px solid oklch(100% 0 0 / 0.06);">
      <p class="text-xs opacity-40">
        &copy; {currentYear} Ixiptla. {lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}
      </p>

      <button
        class="footer-back-to-top text-xs opacity-40 hover:opacity-70 transition-opacity duration-300 flex items-center gap-1"
        aria-label={lang === 'es' ? 'Volver arriba' : 'Back to top'}
      >
        <Icon name="mdi:arrow-up" class="w-3 h-3" />
        {lang === 'es' ? 'Volver arriba' : 'Back to top'}
      </button>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    const backToTop = document.querySelector('.footer-back-to-top');
    if (backToTop) {
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
