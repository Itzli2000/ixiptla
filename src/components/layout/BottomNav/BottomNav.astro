---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import type { Language } from "../../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const routes = {
  home: `/${lang}`,
  collection: `/${lang}/collection`,
  contact: `/${lang}/contact`,
};

const pathname = Astro.url.pathname;

const navItems = [
  {
    href: routes.home,
    label: t("navigation.home"),
    icon: "home",
    isActive: pathname === routes.home || pathname === `${routes.home}/`,
  },
  {
    href: routes.collection,
    label: t("navigation.collection"),
    icon: "grid_view",
    isActive: pathname.startsWith(routes.collection),
  },
  {
    href: routes.contact,
    label: t("navigation.contact"),
    icon: "mail",
    isActive: pathname.startsWith(routes.contact),
  },
];
---

<nav
  class="lg:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-[var(--oc-background)]/90 backdrop-blur-xl border-t border-stone-800/15"
>
  {
    navItems.map((item) => (
      <a
        href={item.href}
        aria-current={item.isActive ? "page" : undefined}
        class:list={[
          "flex flex-col items-center justify-center px-4 py-2 transition-colors",
          item.isActive
            ? "text-[var(--oc-primary)] bg-[var(--oc-surface-container-high)]"
            : "text-stone-500",
        ]}
      >
        <span class="material-symbols-outlined">{item.icon}</span>
        <span class="font-label text-[10px] font-bold uppercase">
          {item.label}
        </span>
      </a>
    ))
  }
</nav>
