---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import LanguageSwitcher from "../../common/LanguageSwitcher/LanguageSwitcher.astro";
import ThemeSwitcher from "../../common/ThemeSwitcher/ThemeSwitcher.astro";
import type { Language } from "../../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const routes = {
  home: `/${lang}`,
  collection: `/${lang}/collection`,
  contact: `/${lang}/contact`,
};
---

<nav
  class="nav-main fixed top-0 left-0 right-0 w-full z-50 px-4 transition-all duration-500"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center nav-inner transition-all duration-500" style="height: 5rem;">
      <div class="flex-shrink-0">
        <a
          href={routes.home}
          class="text-xl font-bold"
          aria-label="Ixiptla Home"
        >
        <Icon name="logo" class="w-auto h-10 md:h-12 lg:h-[50px]" />
        </a>
      </div>

      <div class="flex items-center gap-5 lg:gap-10">
      <div class="hidden md:block">
        <div
          class="ml-10 flex items-center space-x-1"
        >
          <a
            href={routes.home}
            class="nav-link relative px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
            aria-current={Astro.url.pathname === routes.home
              ? "page"
              : undefined}
          >
            {t("navigation.home")}
          </a>
          <a
            href={routes.collection}
            class="nav-link relative px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
            aria-current={Astro.url.pathname === routes.collection
              ? "page"
              : undefined}
          >
            {t("navigation.collection")}
          </a>
          <a
            href={routes.contact}
            class="nav-link relative px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
            aria-current={Astro.url.pathname === routes.contact
              ? "page"
              : undefined}
          >
            {t("navigation.contact")}
          </a>
        </div>
      </div>

      <ThemeSwitcher class="mr-2 md:mr-4 max-w-10" />

      <LanguageSwitcher />

      <div class="md:hidden flex items-center">
        <button
          class="mobile-menu-button p-2 rounded-md hover:bg-base-200/50 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="mdi:menu" class="w-6 h-6" />
        </button>
      </div>
    </div>
    </div>

    <div
      class="hidden md:hidden mobile-menu"
      id="mobile-menu"
      aria-label="Mobile menu"
    >
      <div class="px-2 pt-2 pb-3 space-y-1">
        <a
          href={routes.home}
          class="block px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
          aria-current={Astro.url.pathname === routes.home ? "page" : undefined}
        >
          {t("navigation.home")}
        </a>
        <a
          href={routes.collection}
          class="block px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
          aria-current={Astro.url.pathname === routes.collection
            ? "page"
            : undefined}
        >
          {t("navigation.collection")}
        </a>
        <a
          href={routes.contact}
          class="block px-3 py-2 rounded-md hover:bg-base-200/50 transition-colors"
          aria-current={Astro.url.pathname === routes.contact
            ? "page"
            : undefined}
        >
          {t("navigation.contact")}
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const nav = document.querySelector(".nav-main") as HTMLElement;
    const navInner = document.querySelector(".nav-inner") as HTMLElement;
    if (!nav) return;

    // Scroll-aware nav: transparent -> frosted glass
    const handleScroll = () => {
      const scrolled = window.scrollY > 80;
      nav.classList.toggle("nav-scrolled", scrolled);
      if (navInner) {
        navInner.style.height = scrolled ? "4rem" : "5rem";
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll(); // Initial state

    // Mobile menu
    const mobileMenuButton = document.querySelector(".mobile-menu-button");
    const mobileMenu = document.querySelector(".mobile-menu");

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener("click", () => {
        const isExpanded = mobileMenu.classList.toggle("hidden");
        mobileMenu.classList.toggle("open");
        mobileMenuButton.setAttribute(
          "aria-expanded",
          (!isExpanded).toString()
        );
      });

      const mobileLinks = mobileMenu.querySelectorAll("a");
      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          mobileMenu.classList.remove("open");
          mobileMenuButton.setAttribute("aria-expanded", "false");
        });
      });

      document.addEventListener("click", (event) => {
        if (
          !mobileMenuButton.contains(event.target as Node) &&
          !mobileMenu.contains(event.target as Node) &&
          !mobileMenu.classList.contains("hidden")
        ) {
          mobileMenu.classList.add("hidden");
          mobileMenu.classList.remove("open");
          mobileMenuButton.setAttribute("aria-expanded", "false");
        }
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          !mobileMenu.classList.contains("hidden")
        ) {
          mobileMenu.classList.add("hidden");
          mobileMenu.classList.remove("open");
          mobileMenuButton.setAttribute("aria-expanded", "false");
        }
      });
    }
  });
</script>

<style>
  /* Default: transparent nav */
  .nav-main {
    background: transparent;
    backdrop-filter: blur(0px);
    box-shadow: none;
  }

  /* Scrolled: frosted glass */
  .nav-main.nav-scrolled {
    background: oklch(from var(--color-base-100) l c h / 0.85);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 oklch(0% 0 0 / 0.05);
  }

  [data-theme="ixpitla-dark"] .nav-main.nav-scrolled {
    background: oklch(from var(--color-base-100) l c h / 0.8);
    box-shadow: 0 1px 0 oklch(100% 0 0 / 0.05);
  }

  /* Active link indicator */
  .nav-link[aria-current="page"]::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(1);
    width: 60%;
    height: 2px;
    background: var(--color-primary-rich);
    border-radius: 1px;
    transition: transform 0.3s var(--ease-expo-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 60%;
    height: 2px;
    background: var(--color-primary-rich);
    border-radius: 1px;
    transition: transform 0.3s var(--ease-expo-out);
  }

  .nav-link:hover::after {
    transform: translateX(-50%) scaleX(0.6);
  }

  .nav-link[aria-current="page"]::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Mobile menu */
  .mobile-menu {
    transition: all 0.3s ease-in-out;
    max-height: 0;
    overflow: hidden;
  }

  .mobile-menu.open {
    max-height: 300px;
  }
</style>
