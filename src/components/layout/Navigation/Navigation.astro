---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import LanguageSwitcher from "../../common/LanguageSwitcher/LanguageSwitcher.astro";
import ThemeSwitcher from "../../common/ThemeSwitcher/ThemeSwitcher.astro";
import type { Language } from "../../../types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);

const routes = {
  home: `/${lang}`,
  collection: `/${lang}/collection`,
  contact: `/${lang}/contact`,
};

const isActive = (route: string) => Astro.url.pathname === route;
---

<nav
  class="fixed top-0 z-50 w-full bg-(--oc-background)"
  aria-label="Main navigation"
>
  <div class="flex justify-between items-center w-full px-8 py-4">
    <!-- Left side: Logo + Desktop Nav -->
    <div class="flex items-center gap-8">
      <a href={routes.home} aria-label="Ixiptla Home">
        <span class="text-2xl font-black tracking-[-0.02em] text-(--oc-primary) uppercase font-label">IXIPTLA</span>
      </a>

      <div class="hidden lg:flex gap-8">
        <a
          href={routes.home}
          class:list={[
            "font-label text-sm uppercase tracking-widest transition-colors duration-300",
            isActive(routes.home)
              ? "text-(--oc-primary) border-b-2 border-(--oc-primary) pb-1"
              : "text-stone-500 hover:text-(--oc-primary)",
          ]}
          aria-current={isActive(routes.home) ? "page" : undefined}
        >
          {t("navigation.home")}
        </a>
        <a
          href={routes.collection}
          class:list={[
            "font-label text-sm uppercase tracking-widest transition-colors duration-300",
            isActive(routes.collection)
              ? "text-(--oc-primary) border-b-2 border-(--oc-primary) pb-1"
              : "text-stone-500 hover:text-(--oc-primary)",
          ]}
          aria-current={isActive(routes.collection) ? "page" : undefined}
        >
          {t("navigation.collection")}
        </a>
        <a
          href={routes.contact}
          class:list={[
            "font-label text-sm uppercase tracking-widest transition-colors duration-300",
            isActive(routes.contact)
              ? "text-(--oc-primary) border-b-2 border-(--oc-primary) pb-1"
              : "text-stone-500 hover:text-(--oc-primary)",
          ]}
          aria-current={isActive(routes.contact) ? "page" : undefined}
        >
          {t("navigation.contact")}
        </a>
      </div>
    </div>

    <!-- Right side: Controls -->
    <div class="flex items-center gap-4">
      <ThemeSwitcher class="max-w-10" />
      <LanguageSwitcher />

      <button
        class="lg:hidden sidenav-toggle p-2 text-stone-500 hover:text-(--oc-primary) transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>


</nav>
